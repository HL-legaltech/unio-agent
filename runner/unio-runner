class Stop(Exception):
    """Ends the command with a message for the person and an exit code."""

    def __init__(self, message, code=1):
        super().__init__(message)
        self.message = message
        self.code = code


def say(text=""):
    print(text, flush=True)


def clean(text, limit=80):
    """Text a server sent or a person typed, safe to print on a terminal."""
    return re.sub(r"[\x00-\x1f\x7f]", "", str(text))[:limit]


def last_line(text, limit=200):
    """The last line a failed command printed, without colors or control bytes."""
    lines = [clean(re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", line), limit) for line in str(text or "").splitlines()]
    lines = [line.strip() for line in lines if line.strip()]
    return lines[-1] if lines else ""


def tilde(path):
    """A path as people read it, with ~ for the home folder (POSIX only)."""
    text = str(path)
    if os.name == "nt":
        return text
    home = str(Path.home())
    if text == home:
        return "~"
    if text.startswith(home + "/"):
        return "~/" + text[len(home) + 1:]
    return text


def shown(path):
    """A path for a command the person may copy: ~ when it needs no quoting."""
    text = tilde(path)
    return text if re.fullmatch(r"[~A-Za-z0-9_./@+-]+", text) else shlex.quote(str(path))


def self_command():
    """How a person runs this file: `unio runner`, or the clone's bin/unio by
    its path while the unio on PATH is another one or none, as right after
    install.sh when ~/.local/bin is not on PATH yet."""
    found = shutil.which("unio")
    try:
        ours = bool(found) and os.path.samefile(str(Path(found).resolve().parent), str(CLONE / "bin"))
    except OSError:
        ours = False
    if ours:
        return "unio runner"
    if os.name == "nt":
        return '& "%s" runner' % (CLONE / "bin" / "unio.cmd")
    return shown(CLONE / "bin" / "unio") + " runner"


def foreground_command(org):
    if os.name == "nt":
        return '& "%s" "%s" --workspace %s' % (sys.executable, inbox_path(), org)
    return "python3 %s --workspace %s" % (shown(inbox_path()), org)


def run(argv, env=None, timeout=120):
    """(exit code, stdout, stderr) of a command, which never raises: 127 when it
    is missing, 124 when it ran past the timeout. Commands are resolved on PATH
    first, so Windows finds .cmd and .bat shims too."""
    argv = [str(a) for a in argv]
    found = shutil.which(argv[0], path=(env or os.environ).get("PATH"))
    if found:
        argv[0] = found
    try:
        done = subprocess.run(
            argv, stdin=subprocess.DEVNULL, capture_output=True, encoding="utf-8", errors="replace", env=env,
            timeout=timeout)
    except FileNotFoundError:
        return 127, "", "%s: command not found" % argv[0]
    except subprocess.TimeoutExpired:
        return 124, "", "%s: timed out after %s s" % (argv[0], timeout)
    except OSError as e:
        return 126, "", "%s: %s" % (argv[0], e)
    return done.returncode, done.stdout or "", done.stderr or ""


def must(result, what):
    code, out, err = result
    if code != 0:
        why = last_line(err) or last_line(out) or "código %d" % code
        raise Stop("Não foi possível %s (%s)." % (what, why))
    return result


def write_atomic(path, data, mode=None):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".new")
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600 if mode is None else mode)
    try:
        os.write(fd, data)
    finally:
        os.close(fd)
    if mode is not None and os.name != "nt":
        os.chmod(str(tmp), mode)
    os.replace(str(tmp), str(path))


def write_secret(path, data):
    write_atomic(path, data, mode=0o600)


def private_dir(path):
    path = Path(path)
    path.mkdir(parents=True, exist_ok=True)
    if os.name != "nt":
        os.chmod(str(path), 0o700)


def read_bytes(path):
    try:
        return Path(path).read_bytes()
    except OSError:
        return None


def inbox_path():
    return HERE / "unio-inbox"


def child_env(api=None):
    env = dict(os.environ)
    env["PYTHONUTF8"] = "1"
    env["PYTHONIOENCODING"] = "utf-8"
    if api:
        env["UNIO_API_URL"] = api
    return env


class Profile:
    def __init__(self, org, config, state, token):
        self.org = org
        self.config = Path(config)
        self.state = Path(state)
        self.token = Path(token)

    @property
    def env_file(self):
        return self.config / "env"

    @property
    def repos_file(self):
        return self.config / "repos.json"

    @property
    def log_file(self):
        return self.state / "log.jsonl"


def profile(org, env=None):
    inbox = inbox_path()
    if not inbox.is_file():
        raise Stop("O unio-inbox não está em %s. Atualize o clone com %s update e rode este comando de novo."
                   % (tilde(inbox), self_command()))
    code, out, err = run([sys.executable, inbox, "--workspace", org, "--print-paths"],
                         env=env or child_env(), timeout=60)
    try:
        data = json.loads(out)
        paths = {key: data[key] for key in ("config", "state", "token")}
        if not all(isinstance(v, str) and v for v in paths.values()):
            paths = None
    except (ValueError, KeyError, TypeError):
        paths = None
    if code != 0 or not paths:
        why = last_line(err) or last_line(out)
        raise Stop("O unio-inbox não informou as pastas do perfil %s%s." % (org, " (%s)" % why if why else ""))
    return Profile(org, **paths)


def profiles():
    """The workspace ids that have a profile on this computer."""
    # unio-inbox owns the path rule. Every profile sits in the same parent
    # folder, so the paths of any valid id point at it.
    root = profile("org_0").config.parent
    try:
        return sorted(p.name for p in root.iterdir() if p.is_dir() and ORG.match(p.name))
    except OSError:
        return []


def read_env_file(path):
    """KEY=VALUE lines, # comments, quotes around a whole value dropped: the
    profile's env as unio-inbox reads it."""
    values = {}
    try:
        text = Path(path).read_text(encoding="utf-8").lstrip("﻿")
    except OSError:
        return values
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        values[key] = value
    return values


def set_env_value(path, key, value):
    try:
        lines = Path(path).read_text(encoding="utf-8").splitlines()
    except OSError:
        lines = []
    kept, done = [], False
    for line in lines:
        name = line.split("=", 1)[0].strip() if "=" in line and not line.strip().startswith("#") else None
        if name == key:
            if not done:
                kept.append("%s=%s" % (key, value))
                done = True
            continue
        kept.append(line)
    if not done:
        kept.append("%s=%s" % (key, value))
    write_atomic(path, ("\n".join(kept) + "\n").encode("utf-8"), mode=0o600)


def normalize_api(url):
    url = (url or "").strip().rstrip("/")
    if re.search(r"[^A-Za-z0-9.:/_-]", url) or not re.match(
            r"^(https://[^/]+|http://(127\.0\.0\.1|localhost):[0-9]+)(/.*)?$", url):
        raise Stop("O valor de --api não é um endereço da API do Unio (https://..., ou http://localhost:<porta>).", 2)
    if re.match(r"^https?://[^/]+$", url):
        url += "/v1"
    return url


def effective_api(prof, given=None):
    """The API unio-inbox will call: --api, else the real environment, else the
    profile's env file, else the default."""
    api = given or os.environ.get("UNIO_API_URL") or read_env_file(prof.env_file).get("UNIO_API_URL")
    return (api or DEFAULT_API).rstrip("/")


def agents_me(api, token, timeout=15):
    """(HTTP status, JSON body) of GET /agents/me; status 0 when nothing answered."""
    req = urllib.request.Request(api + "/agents/me", headers={
        "Authorization": "Bearer " + token, "Accept": "application/json", "User-Agent": "unio-runner"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as reply:
            return reply.status, json.loads(reply.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        return e.code, None
    except (urllib.error.URLError, OSError, ValueError):
        return 0, None


def run_check(org, env):
    code, out, err = run([sys.executable, inbox_path(), "--workspace", org, "--check"], env=env, timeout=90)
    data = None
    for text in (out.strip(), (out.strip().splitlines() or [""])[-1]):
        try:
            data = json.loads(text)
            break
        except ValueError:
            continue
    if not isinstance(data, dict):
        data = {"ok": False, "problems": [last_line(err) or "unio-inbox --check printed no result"]}
    data["ok"] = bool(data.get("ok")) and code == 0
    return data


