def platform_name(platform=None):
    """The system as the agent's page names it: linux, macos or windows."""
    platform = platform or sys.platform
    if platform.startswith("linux"):
        return "linux"
    return {"darwin": "macos", "win32": "windows", "cygwin": "windows"}.get(platform, platform)


