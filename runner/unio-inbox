def problem_message(reason, until=None, detail=None):
    """One English line about a problem: a release's note, which the agent's page
    shows, and the presence's message, which the server keeps to itself."""
    text = PROBLEMS.get(reason, "the runner hit a problem") + (f" ({detail})" if detail else "")
