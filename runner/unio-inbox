def rule_path(path, windows=None):
    """An absolute path as a permission rule names it: '//' and the path.
    Claude Code matches Windows paths in POSIX form, C:\\Users as /c/Users."""
    if not (os.name == "nt" if windows is None else windows):
        return "/" + str(path)
    p = PureWindowsPath(path)
    return "//" + "/".join([p.drive.rstrip(":").lower(), *p.parts[1:]])


def utcnow():
