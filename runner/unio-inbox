def quiet_flags():
    """Popen options for a helper process. The Windows service runs under
    pythonw.exe, without a console, so each console program it starts would
    open a window of its own."""
    return {"creationflags": subprocess.CREATE_NO_WINDOW} if os.name == "nt" else {}


def group_flags():
    """Popen options that give a session a process group of its own, so
    stopping it stops whatever it started too."""
    if os.name == "nt":
        return {"creationflags": subprocess.CREATE_NEW_PROCESS_GROUP | subprocess.CREATE_NO_WINDOW}
    return {"start_new_session": True}


def stop_group(proc, force=False):
    """SIGTERM (or SIGKILL) to the session's process group. Windows has no
    signal for a group: taskkill ends the whole tree at once."""
    if os.name == "nt":
        try:
            subprocess.run(["taskkill", "/T", "/F", "/PID", str(proc.pid)], stdin=subprocess.DEVNULL,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30, **quiet_flags())
        except (OSError, subprocess.SubprocessError):
            pass
        return
    try:
        os.killpg(proc.pid, signal.SIGKILL if force else signal.SIGTERM)
    except (ProcessLookupError, PermissionError):
        # macOS answers EPERM for a group left with only its unreaped leader.
        pass


@contextmanager
def file_lock(path):
    """Whether this process holds the lock on `path`, kept until the block
    ends: flock on POSIX, a lock on the file's first byte on Windows. Opened
    to append, since Windows refuses to truncate a file another process locks."""
    with open(path, "a", encoding="utf-8") as f:
        if os.name != "nt":
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                yield False
                return
            yield True
            return
        f.seek(0)
        try:
            msvcrt.locking(f.fileno(), msvcrt.LK_NBLCK, 1)
        except OSError:
            yield False
            return
        try:
            yield True
        finally:
            f.seek(0)
            try:
                msvcrt.locking(f.fileno(), msvcrt.LK_UNLCK, 1)
            except OSError:
                pass


def replace_file(src, dst):
    """os.replace, retried for a moment on Windows, where it fails while
    another process (a status check) has `dst` open."""
    for attempt in range(5):
        try:
            return os.replace(src, dst)
        except PermissionError:
            if os.name != "nt" or attempt == 4:
                raise
            time.sleep(0.1)


def remove_tree(path):
    """shutil.rmtree, errors ignored, that also takes read-only files: git
    leaves its objects read-only, and Windows refuses to delete those."""
    def writable(func, target, _error):
        try:
            os.chmod(target, stat.S_IWRITE)
            func(target)
        except OSError:
            pass

    if sys.version_info >= (3, 12):
        shutil.rmtree(path, onexc=writable)
    else:
        shutil.rmtree(path, onerror=writable)


def write_atomic(path, text):
