DESK_FILE = Path.home() / ".local/state/unio/desk/desk.json"
MEMINFO = "/proc/meminfo"
# unio-desk's "tight" floor, in GiB. 4 GiB is one surge from the OOM line (six next
# dev servers grew 0.55-0.83 GB each in 25 min). Past 1 GiB of free swap the kernel
# evicts executable pages (the 2026-08-07 stall), which bites only under 8 GiB
# available: swap 84 % full beside 12-16 GiB available was harmless. Measured on the
# one workstation the runner without --workspace serves, so a profile never uses them.
AVAIL_FLOOR_GIB = 4
SWAP_FLOOR_GIB = 1
SWAP_GATE_GIB = 8
# unio-desk rewrites desk.json every 15 s at tight or above; an older one is a dead governor's.
DESK_FRESH = 90


def desk_memory(floor=None):
    """Why no session may start now, or None. Reads /proc itself, so it holds
    with no governor alive; desk.json only adds unio-desk's critical levels.
    `floor` is None for the workstation floors above, or a profile's own
    floor in GiB available (Config.memory_floor), where 0 never holds.
    Linux only: other systems have no /proc/meminfo, and no floor was
    measured on them, so nothing holds there (serve() logs it once)."""
    if not sys.platform.startswith("linux"):
        return None
    try:
        with open(MEMINFO, encoding="utf-8") as f:
            mi = {k: int(v.split()[0]) for k, v in (line.split(":", 1) for line in f)}
        avail, swap_free = mi["MemAvailable"] / 2**20, mi["SwapFree"] / 2**20
        detail = f"{avail:.1f} GiB free of {mi['MemTotal'] / 2**20:.0f} GiB"
    except (OSError, ValueError, KeyError, IndexError):
        return None  # unreadable: never hold, as ready() does
    if floor is not None:
        if avail < floor:
            return detail
    elif avail < AVAIL_FLOOR_GIB or (swap_free < SWAP_FLOOR_GIB and avail < SWAP_GATE_GIB):
        return detail
    try:
        if time.time() - DESK_FILE.stat().st_mtime < DESK_FRESH and \
                json.loads(DESK_FILE.read_text(encoding="utf-8")).get("level") in ("critical", "emergency"):
            return detail
    except (OSError, ValueError, AttributeError):
        pass
    return None


def project_slugs(cwd):
    """The names Claude Code (2.1.287) may give the project directory of a session
    run in `cwd`: every character outside [a-zA-Z0-9] becomes '-', and a name
    over 200 characters is cut there and suffixed with a hash. Both the path as
    given and as resolved, since the runner cannot see which one it used."""
    return {re.sub(r"[^a-zA-Z0-9]", "-", p) for p in (str(cwd), os.path.realpath(cwd))}


def claude_projects_dir(env=os.environ):
    return Path(env.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude") / "projects"


def remove_project_dirs(cwd, prefix=False):
    """The directories Claude Code wrote for sessions in `cwd`, or with prefix=True
    for sessions anywhere under it. --no-session-persistence keeps the transcript
    out, but a tool result too large for the context is still saved there.
    Every session runs in a `work` folder the runner made, so under a prefix
    only a name ending in -work (or in the hash a cut name ends in) is one of
    the runner's: a slug is lossy, and another folder can share its start."""
    try:
        entries = list(claude_projects_dir().iterdir())
    except OSError:
        return
    for slug in project_slugs(cwd):
        for d in entries:
            if prefix:
                match = d.name.startswith((slug + "-")[:200]) and (len(d.name) > 200 or d.name.endswith("-work"))
            else:
                match = d.name == slug if len(slug) <= 200 else d.name.startswith(slug[:200] + "-")
            if match and d.is_dir() and not d.is_symlink():
                shutil.rmtree(d, ignore_errors=True)


