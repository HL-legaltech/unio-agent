    for sessions anywhere under it. --no-session-persistence keeps the transcript
    out, but a tool result too large for the context is still saved there.
    Every session runs in a `work` folder the runner made, so under a prefix
    only a name ending in -work (or in the hash a cut name ends in) is one of
    the runner's: a slug is lossy, and another folder can share its start."""
    try:
        entries = list(claude_projects_dir().iterdir())
    except OSError:
        return
    for slug in project_slugs(cwd):
        for d in entries:
            if prefix:
                match = d.name.startswith((slug + "-")[:200]) and (len(d.name) > 200 or d.name.endswith("-work"))
            else:
                match = d.name == slug if len(slug) <= 200 else d.name.startswith(slug[:200] + "-")
            if match and d.is_dir() and not d.is_symlink():
                shutil.rmtree(d, ignore_errors=True)


WORKSPACE_ID = re.compile(r"^org_[A-Za-z0-9]+$")
# The protocols this runner ships; a profile's own copy of one wins.
PROTOCOL_DIR = Path(__file__).resolve().parent / "protocol"
ENV_KEY = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
# Where a profile lives is decided before its env file is read, so the file cannot move it.
PATH_KEYS = {"HOME", "USERPROFILE", "XDG_CONFIG_HOME", "XDG_STATE_HOME", "APPDATA", "LOCALAPPDATA"}


def profile_dirs(workspace, env=os.environ, platform=None):
    """(config, state) folders of a workspace's profile, as pure paths in the
    system's own form; unio-runner asks for them with --print-paths rather
    than computing them again."""
    if platform_name(platform) == "windows":
        home = PureWindowsPath(env.get("USERPROFILE") or str(Path.home()))
        roaming = PureWindowsPath(env.get("APPDATA") or home / "AppData" / "Roaming")
        local = PureWindowsPath(env.get("LOCALAPPDATA") or home / "AppData" / "Local")
        return roaming / "unio" / "runners" / workspace, local / "unio" / "runners" / workspace
    home = PurePosixPath(str(Path.home()))
    config = PurePosixPath(env.get("XDG_CONFIG_HOME") or home / ".config")
    state = PurePosixPath(env.get("XDG_STATE_HOME") or home / ".local" / "state")
    return config / "unio" / "runners" / workspace, state / "unio" / "runners" / workspace


def read_env_file(path):
    """A profile's env file as {KEY: VALUE}: one KEY=VALUE a line, '#' lines
    are comments, and quotes around a whole value go."""
    try:
        text = Path(path).read_text(encoding="utf-8").lstrip("\ufeff")
    except OSError:
        return {}
    values = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        if ENV_KEY.match(key) and key not in PATH_KEYS:
            values[key] = value
    return values


def apply_env_file(path, environ=os.environ):
    """Sets each variable the env file holds and the environment does not: the
    real environment wins. Returns the names it set, for the start line."""
    taken = []
    for key, value in read_env_file(path).items():
        if key not in environ:
            environ[key] = value
            taken.append(key)
    return taken


# Profile mode's self-update: how often the clone is compared with main, and the
# exit status that asks the service manager to start the runner again (EX_TEMPFAIL).
UPDATE_EVERY = timedelta(hours=6)
RESTART_EXIT = 75
# A file in a profile's state folder that stops its runner as SIGTERM does. On
# Windows nothing can send the windowless pythonw.exe a signal it can catch, and
# Task Scheduler's /End kills it with its item still claimed, so unio-runner
# writes this instead. The runner looks every second.
STOP_FILE = "stop"
# The clone this file runs from: runner/unio-inbox is two levels below its root.
CLONE_ROOT = Path(__file__).resolve().parent.parent
SEMVER = re.compile(r"^(\d+)\.(\d+)(?:\.(\d+))?$")


def parse_version(text):
    """(major, minor, patch) of "2.0.0" (or of "1.7", patch 0), or None."""
    m = SEMVER.match(str(text or "").strip())
    return tuple(int(part or 0) for part in m.groups()) if m else None


def newer(candidate, current):
    """Whether version `candidate` is above `current`; never when either is unreadable."""
    a, b = parse_version(candidate), parse_version(current)
    return a is not None and b is not None and a > b


def autoupdate_on(env=os.environ):
    return (env.get("UNIO_RUNNER_AUTOUPDATE") or "on").strip().lower() not in ("off", "0", "false", "no")


class UpdateError(Exception):
    pass


class Updater:
    """A profile's runner keeps itself current from the clone it runs from.
    check() is called between polls, never during a session: it fetches
    origin main and, when main's runner/VERSION is above this process's and
    the clone is main with no local change, fast-forwards it. The caller then
    exits with RESTART_EXIT. Failures are logged and wait for the next check."""

    def __init__(self, root, git, log, version=VERSION):
        self.root = Path(root)
        self.git = git
        self.log = log
        self.version = version
        self.next_at = None
        self.skipped = set()

    def disk_version(self):
        try:
            return (self.root / "runner" / "VERSION").read_text(encoding="utf-8").strip()
        except OSError:
            return None

    def due(self, now):
        """At start, every UPDATE_EVERY, and as soon as the clone holds a newer
        runner than this process: another profile's runner, or unio-runner
        update, may have moved the clone they share."""
        return self.next_at is None or now >= self.next_at or newer(self.disk_version(), self.version)

    def check(self, now):
        """(from, to) when the clone now holds a newer runner, else None. Never raises."""
        self.next_at = now + UPDATE_EVERY
        try:
            return self._check()
        except UpdateError as e:
            self.log("update_failed", error=short(e, 300))
        except Exception as e:  # an update must never stop the answers
            self.log("update_failed", error=f"runner: {type(e).__name__}: {short(e, 300)}")
        return None

    def _check(self):
        on_disk = self.disk_version()
        if newer(on_disk, self.version):
            return self.version, on_disk
        if not (self.root / ".git").exists():
            return self._skip("not_a_clone", f"{self.root} is not a git clone")
        code, branch = self._git("symbolic-ref", "--quiet", "--short", "HEAD", ok=(0, 1))
        if code or branch != "main":
            return self._skip("branch", f"the clone is on {branch or 'a detached HEAD'}, not main")
        if self._git("status", "--porcelain", "--untracked-files=no")[1]:
            return self._skip("local_changes", "the clone has local changes")
        self._git("fetch", "--quiet", "origin", "main", timeout=120)
        fetched = self._git("rev-parse", "--verify", "FETCH_HEAD^{commit}")[1]
        remote = self._git("show", f"{fetched}:runner/VERSION")[1].strip()
        if not newer(remote, self.version):
            return None
        if self._git("merge-base", "--is-ancestor", "HEAD", fetched, ok=(0, 1))[0]:
            return self._skip("diverged", "the clone has commits main does not")
        self._git("merge", "--ff-only", "--quiet", fetched, timeout=120)
        return self.version, remote

    def _skip(self, reason, detail):
        """Logged once per reason: the clone stays as it is, and so does the next check's answer."""
        if reason not in self.skipped:
            self.skipped.add(reason)
            self.log("update_skipped", reason=reason, detail=detail)
        return None

    def _git(self, *args, timeout=60, ok=(0,)):
        env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}
        try:
            p = text_run([self.git, "-C", str(self.root), "-c", f"core.hooksPath={os.devnull}", *args],
                         timeout=timeout, env=env)
        except (OSError, subprocess.TimeoutExpired) as e:
            raise UpdateError(f"git {args[0]}: {short(e, 200)}") from None
        if p.returncode not in ok:
            raise UpdateError(f"git {args[0]}: exit {p.returncode}: {short(p.stderr or p.stdout, 300)}")
        return p.returncode, p.stdout.strip()


