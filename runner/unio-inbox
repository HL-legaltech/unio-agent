def parse_version(text):
    """(major, minor, patch) of "2.0.0" (or of "1.7", patch 0), or None."""
    m = SEMVER.match(str(text or "").strip())
    return tuple(int(part or 0) for part in m.groups()) if m else None


def newer(candidate, current):
    """Whether version `candidate` is above `current`; never when either is unreadable."""
    a, b = parse_version(candidate), parse_version(current)
    return a is not None and b is not None and a > b


