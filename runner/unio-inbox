        # Task id -> (search row updatedAt, when read) for tasks read without a Needs section.
        self.needs_quiet = {}
        # A check that failed for the machine's sake holds the next one this long, charging no task.
        self.needs_judge_hold = None
        self.status_pass_at = None
        self.status_off_logged = set()
        # Project id -> (the move, when it may be tried again) for a move the server refused.
        self.status_refused = {}
        # Observe mode, and a finish waiting out its day, log a project's decision when it changes.
        self.status_seen = {}
        self._workspace = None
        # Whether this server takes usage and research on settlement (settle()).
        self.settle_extras = True
        # What this server took on progress, for the life of the process (Progress.support).
        self.progress_support = {"fields": True, "reading_source": None, "stoppable": True}
        # The teams GET /agents/me listed, for the responder's workspace section.
        self._team_rows = None
        # The agent's writing language, read with the teams; English until then.
        self.language = "en"
        # The account the last `claude auth status` named (account_id), and when a
        # usage-limit pause last asked; a probe that failed holds the next one.
        self.account = None
        self.account_checked_at = None
        self.probe_hold = None

    @staticmethod
    def session_env():
        env = {k: v for k, v in os.environ.items() if k not in SESSION_VARS}
        env.update(SESSION_ENV)
        return env

    def save(self, h):
        status = self.presence.status()
        if status:
            h["presence"] = status
        self.state.save_health(h)

    def claude_args(self, mcp_path, snapshots, protocol=None):
        # The prompt goes in on stdin: --add-dir, --tools and the other list
        # options take every following word, a trailing prompt included.
        args = [
            self.cfg.claude, "-p", "--restricted",
            "--output-format", "stream-json", "--verbose", "--no-session-persistence",
            "--settings", self.settings_arg(),
            # No web: a run that holds untrusted pages never holds every unio write
            # too. A research run (research_args) takes what needs the web.
            "--tools", "Read,Grep,Glob",
            "--allowedTools", "mcp__unio__*",
            "--mcp-config", str(mcp_path), "--strict-mcp-config",
            "--append-system-prompt-file", str(protocol or self.cfg.responder),
            "--max-turns", str(self.cfg.max_turns), "--max-budget-usd", self.cfg.max_budget,
        ]
        if self.cfg.model:
            args += ["--model", self.cfg.model]
        paths = [s["path"] for s in snapshots]
        for path in paths:
            args += ["--add-dir", path]
        if paths:
            args += ["--disallowedTools"] + [f"Read({rule_path(path)}/**/{g})" for path in paths for g in SECRET_GLOBS]
        return args

    def research_args(self, mcp_path, web, files=None):
        """A research run: the web tools `web` names (none when the weekly gate holds
        them back), five unio tools by name, no repository: no code can reach a query.
        With `files`, a folder of its own, Write confined to it."""
        tools = [*web, *(["Write"] if files else [])]
        args = [
            self.cfg.claude, "-p", "--restricted",
            "--output-format", "stream-json", "--verbose", "--no-session-persistence",
            "--settings", self.settings_arg(),
            "--tools", ",".join(tools),
            "--allowedTools", ",".join([*RESEARCH_MCP_TOOLS, *web, *([files_rule(files)] if files else [])]),
            "--disallowedTools", ",".join([*RESEARCH_DENIED, *(
                f"WebFetch(domain:{host})" for host in self.fetch_denied() if "WebFetch" in web)]),
            "--mcp-config", str(mcp_path), "--strict-mcp-config",
            "--append-system-prompt-file", str(self.cfg.researcher),
            "--max-turns", str(self.cfg.research_max_turns), "--max-budget-usd", self.cfg.research_max_budget,
        ]
        if self.cfg.research_model:
            args += ["--model", self.cfg.research_model]
        return args

    def unio_hosts(self):
        """Unio's own hosts, which research never reads: the API's and the web app's."""
        hosts = [urllib.parse.urlsplit(self.cfg.api).hostname]
        app = (self._workspace or {}).get("appUrl")
        if isinstance(app, str):
            hosts.append(urllib.parse.urlsplit(app).hostname)
        elif hosts[0] and hosts[0].startswith("api."):
            hosts.append(hosts[0][4:])
        return tuple(dict.fromkeys(h.lower() for h in hosts if h))

    def fetch_denied(self):
        return tuple(dict.fromkeys([*FETCH_DENIED, *self.unio_hosts()]))

    def review_args(self, mcp_path):
        # `--tools ""` takes the built-in tools away; no --add-dir: a review reads no code.
        args = [
            self.cfg.claude, "-p", "--restricted",
            "--output-format", "stream-json", "--verbose", "--no-session-persistence",
            "--settings", self.settings_arg(),
            "--tools", "",
            "--allowedTools", ",".join(REVIEW_TOOLS),
            "--mcp-config", str(mcp_path), "--strict-mcp-config",
            "--append-system-prompt-file", str(self.cfg.reviewer),
            "--max-turns", str(self.cfg.review_max_turns), "--max-budget-usd", self.cfg.review_max_budget,
        ]
        if self.cfg.review_model:
            args += ["--model", self.cfg.review_model]
        return args

    def needs_args(self, mcp_path):
        # `--tools ""` takes the built-in tools away. The server offers every unio
        # tool to a connection without a scope header, so each write is denied by name.
        args = [
            self.cfg.claude, "-p", "--restricted",
            "--output-format", "stream-json", "--verbose", "--no-session-persistence",
            "--settings", self.settings_arg(),
            "--tools", "",
            "--allowedTools", ",".join(NEEDS_TOOLS),
            "--disallowedTools", ",".join(UNIO_WRITE_TOOLS),
            "--mcp-config", str(mcp_path), "--strict-mcp-config",
            "--append-system-prompt-file", str(self.cfg.needs_protocol),
            "--max-turns", str(self.cfg.needs_max_turns), "--max-budget-usd", self.cfg.needs_max_budget,
        ]
        if self.cfg.needs_model:
            args += ["--model", self.cfg.needs_model]
        return args

    def settings_arg(self):
        """--settings' value. On Windows a claude.cmd launcher (npm's) passes the
        arguments through cmd.exe, which can mangle a JSON string's quotes, so
        the same JSON goes in a file there."""
        if os.name != "nt":
            return HOOKS_OFF
        path = self.state.dir / "settings.json"
        path.write_text(HOOKS_OFF, encoding="utf-8")
        return str(path)

    def ready(self):
        """Free checks before claiming anything, so a broken machine spends no attempts."""
        if not self.cfg.responder.is_file():
            return "responder_missing", f"{self.cfg.responder} does not exist"
        try:
            p = text_run([self.cfg.claude, "auth", "status", "--json"], timeout=60, env=self.session_env())
        except FileNotFoundError:
            return "claude_unavailable", f"{self.cfg.claude} not found"
        except (subprocess.TimeoutExpired, OSError) as e:
            return "claude_unavailable", f"claude auth status: {short(e, 160)}"
        try:
            status = json.loads(p.stdout)
        except ValueError:
            return None, None
        self.account = account_id(status) or self.account
        if isinstance(status, dict) and status.get("loggedIn") is False:
            return "signed_out", "Claude Code is not signed in (claude auth status); run: claude auth login"
        return None, None

    def session_cost(self, s, cap=None):
        """What a session counts toward the rolling budget. One stopped before its
        result event (a timeout, a stop, a crash) printed no cost but may have
        spent up to its cap; one stopped at init never reached the model."""
        if s.result:
            return float(s.result.get("total_cost_usd") or 0)
        if s.tools is None or s.bad_init:
            return 0.0
        return self.cfg.max_budget_usd if cap is None else cap

    def over_budget(self, h, now):
        """(until, detail) while the rolling caps hold the runner back, else None."""
        runs = []
        for r in h.get("sessions") or []:
            at = parse_iso(r.get("at")) if isinstance(r, dict) else None
            if at and at > now - timedelta(hours=24):
                runs.append((at, float(r.get("usd") or 0)))
        runs.sort()
        found = []
        spent = sum(usd for _, usd in runs)
        if runs and spent >= self.cfg.daily_budget:
            left = spent
            for at, usd in runs:
                left -= usd
                if left < self.cfg.daily_budget:
                    found.append((at + timedelta(hours=24),
                                  f"{spent:.2f} USD in 24 h, cap {self.cfg.daily_budget:g}"))
                    break
        hour = [at for at, _ in runs if at > now - timedelta(hours=1)]
        if len(hour) >= self.cfg.hourly_sessions:
            found.append((hour[len(hour) - self.cfg.hourly_sessions] + timedelta(hours=1),
                          f"{len(hour)} sessions in the last hour, cap {self.cfg.hourly_sessions}"))
        return max(found) if found else None

    @staticmethod
    def kill(proc, grace=5):
        stop_group(proc)
        try:
            proc.wait(timeout=grace)
        except subprocess.TimeoutExpired:
            stop_group(proc, force=True)
            proc.wait()

    def run_session(self, item, prompt, snapshots, out, claim, on_wait=None, review=None, needs=False, research=None,
                    timeout=None, files=None):
        """`review` is a project id: the session then reviews that project, with
        its own scope, tools and limits, and no item. `needs` makes it a needs
        check: no scope header, two tools, its own limits. `research`, the web
        tools of a research run, makes it one, for `timeout` seconds."""
        work = out.parent / "work"
        work.mkdir(parents=True, exist_ok=True)
        out.mkdir(parents=True, exist_ok=True)
        (out / "prompt.txt").write_text(prompt, encoding="utf-8")
        # The session cannot read this directory, and the file is gone once it ends.
        mcp_path = self.state.mcp_dir / f"{out.parent.name}.json"
        headers = {"Authorization": f"Bearer {self.cfg.token()}"}
        if review:
            # Never with the inbox headers: the server refuses the pair (403 agent_review_scope).
            headers["X-Unio-Review-Project"] = review
            argv, timeout = self.review_args(mcp_path), self.cfg.review_timeout
            s = Session(REVIEW_TOOLS, set(REVIEW_TOOLS), REVIEW_STEPS)
        elif needs:
            argv, timeout = self.needs_args(mcp_path), self.cfg.needs_timeout
            s = Session(NEEDS_TOOLS, None, NEEDS_STEPS, builtin=())
        else:
            headers.update(scope_headers(item, claim))
            if research is not None:
                argv, timeout = self.research_args(mcp_path, research, files), timeout or self.cfg.research_timeout
                s = Session(required=RESEARCH_REQUIRED, steps=RESEARCH_STEPS,
                            builtin={*research, *(["Write"] if files else [])}, refused=RESEARCH_INIT_REFUSED)
                s.guard = {"key": (item.get("task") or {}).get("key"), "hosts": self.unio_hosts()}
            else:
                argv, timeout = self.claude_args(mcp_path, snapshots, self.responder_file(out)), self.cfg.timeout
                required = PROJECT_REQUIRED_TOOLS if item_subject(item) == "project" else REQUIRED_TOOLS
                s = Session(required=required)
        config = {"mcpServers": {"unio": {"type": "http", "url": self.cfg.mcp_url, "headers": headers}}}
        fd = os.open(mcp_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(config, f)
        try:
            with open(out / "transcript.jsonl", "wb") as transcript, open(out / "stderr.txt", "wb") as errfile:
                try:
                    proc = subprocess.Popen(argv, cwd=work,
                                            env=self.session_env(), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                            stderr=errfile, **group_flags())
                except OSError as e:
                    s.start_error = f"could not start {self.cfg.claude}: {e}"
                    return s
                s.started = True
                reader = threading.Thread(target=self._read, args=(proc, s, transcript), daemon=True)
                reader.start()
                try:
                    proc.stdin.write(prompt.encode())
                    proc.stdin.close()
                except OSError:
                    pass
                deadline = time.monotonic() + timeout
                while True:
                    try:
                        proc.wait(timeout=0.5)
                        break
                    except subprocess.TimeoutExpired:
                        pass
                    if s.bad_init or s.violation or s.stopped_by is not None:
                        self.kill(proc)
                    elif stopping.is_set():
                        s.interrupted = True
                        self.kill(proc)
                    elif time.monotonic() > deadline:
                        s.timed_out = True
                        self.kill(proc)
                    elif on_wait:
                        on_wait(s)
                reader.join(timeout=10)
                if not reader.is_alive():
                    # Each session's pipe would otherwise stay open until the collector finds it.
                    proc.stdout.close()
                s.returncode = proc.returncode
            s.stderr_tail = (out / "stderr.txt").read_bytes()[-2000:].decode("utf-8", "replace")
            return s
        finally:
            mcp_path.unlink(missing_ok=True)
            remove_project_dirs(work)

    def responder_file(self, out):
        """The responder protocol a run reads: the configured file, or, when it
        holds the workspace marker, a copy beside the run's prompt with the
        section written from the agent's teams."""
        try:
            text = self.cfg.responder.read_text(encoding="utf-8")
        except OSError:
            return self.cfg.responder
        if WORKSPACE_MARKER not in text:
            return self.cfg.responder
        path = out / "responder.md"
        path.write_text(fill_protocol(text, workspace_section(self._team_rows, self.cfg.repos_for)), encoding="utf-8")
        return path

    @staticmethod
    def _read(proc, s, transcript):
        for raw in proc.stdout:
            transcript.write(raw)
            transcript.flush()
            try:
                event = json.loads(raw)
            except ValueError:
                continue
            if not isinstance(event, dict):
                continue
            if event.get("parent_tool_use_id") is not None:
                # A subagent's turn (measured on 2.1.311: it inherits the parent's
                # MCP tools). Its writes and steps are never the run's own.
                continue
            kind = event.get("type")
            if kind == "system" and event.get("subtype") == "init":
                Runner._check_init(proc, s, event)
            elif kind in ("assistant", "user"):
                content = (event.get("message") or {}).get("content")
                for block in content if isinstance(content, list) else []:
                    if not isinstance(block, dict):
                        continue
                    if block.get("type") == "tool_use":
                        name = str(block.get("name"))
                        s.tool_uses[block.get("id")] = name
                        s.tool_inputs[block.get("id")] = block.get("input") or {}
                        s.web.use(block)
                        if s.guard and not s.violation and name in ("WebSearch", "WebFetch"):
                            Runner._check_web(proc, s, name, block.get("input"))
                        elif s.guard and not s.violation and name.startswith(UNIO_TOOL_PREFIX) \
                                and name not in RESEARCH_MCP_TOOLS:
                            s.violation = f"tool {name}"
                            stop_group(proc)
                        filing = name == "mcp__unio__create_task" and (block.get("input") or {}).get("project")
                        s.step = "updating_project" if filing else s.steps.get(name, s.step)
                    elif block.get("type") == "tool_result" and block.get("is_error"):
                        name = s.tool_uses.get(block.get("tool_use_id"))
                        if name:
                            s.refused[name] = short(result_text(block.get("content")), 500)
                    elif block.get("type") == "tool_result":
                        name = s.tool_uses.get(block.get("tool_use_id"))
                        if name:
                            s.succeeded.add(name)
                        if name in ("mcp__unio__create_comment", "mcp__unio__update_comment"):
                            Runner._note_answer(s, name, s.tool_inputs.get(block.get("tool_use_id")),
                                                block.get("content"))
                        if name == "WebFetch" and len(content) == 1:
                            # Its structured answer sits beside the message, one per event.
                            answer = event.get("tool_use_result")
                            s.web.answer(block.get("tool_use_id"), answer)
                            if s.guard and not s.violation and isinstance(answer, dict):
                                # Where a redirect landed.
                                Runner._check_web(proc, s, name, {"url": answer.get("url")})
                        if name == POST_UPDATE:
                            health = (s.tool_inputs.get(block.get("tool_use_id")) or {}).get("health")
                            s.posted_health = health if isinstance(health, str) else s.posted_health
                        if name == PROJECT_CREATE:
                            made = made_project(block.get("content"))
                            if made and made not in s.projects:
                                s.projects.append(made)
            elif kind == "rate_limit_event":
                # Stamped on arrival: the run is charged only when it ends, minutes later.
                read_at = iso(utcnow())
                s.rate_limits.update({name: {**w, "at": read_at} for name, w in rate_limits(event).items()})
            elif kind == "result":
                s.result = event

    @staticmethod
    def _check_web(proc, s, name, args):
        """Stops the session when a search or an address carries private text, or
        an address leads off the public web; the kind of problem is kept, never the text."""
        args = args if isinstance(args, dict) else {}
        if name == "WebSearch":
            problem = private_text(args.get("query"), s.guard.get("key"))
        else:
            url = args.get("url")
            if url is None:
                return
            problem = fetch_problem(url, s.guard.get("hosts") or ()) or private_text(url, s.guard.get("key"))
        if problem:
            s.violation = f"{name} {problem}"
            stop_group(proc)

    @staticmethod
    def _note_answer(s, name, args, content):
        """create_comment answers {id, createdAt, task} (write_tools.ts); its body
        and update_comment's are `body`."""
        args = args if isinstance(args, dict) else {}
        body = args.get("body") if isinstance(args.get("body"), str) else None
        if name == "mcp__unio__create_comment":
            if s.answer_id:
                return
            try:
                answer = json.loads(result_text(content))
            except ValueError:
                answer = None
            answer = answer if isinstance(answer, dict) else {}
            nested = answer.get("comment") if isinstance(answer.get("comment"), dict) else {}
            cid = answer.get("id") or nested.get("id")
            if isinstance(cid, str) and cid:
                s.answer_id, s.answer_body = cid, body
        elif s.answer_id and args.get("comment_id") == s.answer_id and body is not None:
            s.answer_body = body

    @staticmethod
    def _check_init(proc, s, event):
        s.tools = [str(t) for t in event.get("tools") or []]
        s.version = event.get("claude_code_version")
        if s.allowed is None:
            s.unexpected_tools = [t for t in s.tools if t in s.refused_at_init
                                  or (t not in s.builtin and not t.startswith(UNIO_TOOL_PREFIX))]
        else:
            s.unexpected_tools = [t for t in s.tools if t not in s.allowed]
        servers = {m.get("name"): m.get("status") for m in event.get("mcp_servers") or [] if isinstance(m, dict)}
        missing = [t for t in s.required if t not in s.tools]
        if servers.get("unio") != "connected" or missing:
            s.unio_unavailable = (f"the unio server is {servers.get('unio') or 'absent'}"
                                  + (f"; missing {', '.join(missing)}" if missing else ""))
        if s.bad_init:
            # Stop it before the first model turn; the wait loop reaps it.
            stop_group(proc)

    def classify(self, s, now=None, timeout=None):
        v = self._classify(s, now or utcnow(), timeout or self.cfg.timeout)
        written = written_outcome(s.succeeded)
        if v.kind in ("release", "fail") and written != "skipped":
            # The answer is out: a release or a retry could only post it twice.
            # A machine problem still pauses the runner for the next item.
            return Verdict("ok", outcome=written, claimed="error", error=v.error, reason=v.reason,
                           detail=v.detail, pause=v.pause,
                           note=f"the run stopped after writing ({PROBLEMS.get(v.reason, 'an error')})")
        return v

    def _classify(self, s, now, timeout):
        ended = self._ended(s, now, timeout)
        if ended:
            return ended
        text = session_text(s)
        question = parse_escalation(text)
        if question is not None:
            outcome, error = check_outcome("research", s.succeeded)
            if error:
                return Verdict("fail", cause="research_after_write", error=error)
            return Verdict("research", question=question or None)
        parsed = parse_outcome(text)
        if not parsed:
            if written_outcome(s.succeeded) != "skipped":
                # The answer is posted; a retry could only post it twice.
                return Verdict("ok", outcome=written_outcome(s.succeeded), claimed="missing")
            return Verdict("fail", cause="no_outcome",
                           error="the final message has no JSON outcome line: " + short(text[-200:], 200))
        outcome, error = check_outcome(parsed["outcome"], s.succeeded)
        if error:
            return Verdict("fail", cause="no_write", error=error)
        return Verdict("ok", outcome=outcome, note=parsed["note"],
                       claimed=parsed["outcome"] if outcome != parsed["outcome"] else None)

    def _ended(self, s, now, timeout):
        """The verdict on a session that did not end cleanly, or None when it did."""
        if s.start_error:
            return Verdict("release", reason="claude_unavailable", error=s.start_error,
                           retry=now + MACHINE_PAUSE, pause=now + MACHINE_PAUSE)
        if s.unexpected_tools:
            offered = ", ".join(sorted(s.allowed)) if s.allowed is not None else \
                ", ".join([*sorted(s.builtin), "the unio server"]) + (" (none of its other writes)"
                                                                       if s.refused_at_init else "")
            return Verdict("release", reason="unexpected_tools",
                           error=f"the session offered tools beyond {offered}: " + ", ".join(s.unexpected_tools),
                           detail=short(", ".join(s.unexpected_tools), 120),
                           retry=now + MACHINE_PAUSE, pause=now + MACHINE_PAUSE)
        if s.unio_unavailable:
            return Verdict("release", reason="unio_unavailable", error=s.unio_unavailable,
                           retry=now + UNIO_RETRY, pause=now + UNIO_RETRY)
        if s.interrupted:
            return Verdict("release", reason="interrupted", error="the runner stopped during the session",
                           retry=now + INTERRUPTED_RETRY)
        ev = s.result or {}
        if s.stopped_by is not None:
            return Verdict("too_large", error="stopped on request")
        if s.violation:
            return Verdict("too_large", error=f"stopped by the web check: {s.violation}")
        if s.timed_out:
            return Verdict("too_large", error=f"timed out after {int(timeout)} s")
        if ev.get("subtype") in CAP_SUBTYPES:
            return Verdict("too_large", error=f"{ev.get('subtype')}: {short('; '.join(map(str, ev.get('errors') or [])), 200)}")
        text = session_text(s)
        if s.returncode != 0 or not s.result or ev.get("is_error"):
            detail = f"{text}\n{s.stderr_tail}"
            reason = blocking_reason(detail, ev.get("api_error_status"))
            error = short(text or s.stderr_tail, 300) or reason
            if reason == "signed_out":
                return Verdict("release", reason=reason, error=error, retry=now + MACHINE_PAUSE,
                               pause=now + MACHINE_PAUSE)
            if reason == "usage_limit":
                until = usage_reset(detail, now) or now + USAGE_LIMIT_FALLBACK
                return Verdict("release", reason=reason, error=error, retry=min(until, now + MAX_RETRY_AHEAD),
                               pause=until)
            if reason == "model_unavailable":
                return Verdict("release", reason=reason, error=error, retry=now + MODEL_RETRY,
                               pause=now + MODEL_RETRY)
        if s.returncode != 0:
            return Verdict("fail", error=f"claude exited {s.returncode}: {short(text or s.stderr_tail, 300)}")
        if not s.result:
            return Verdict("fail", error="claude printed no result")
        if ev.get("is_error"):
            return Verdict("fail", error=f"claude reported an error: {short(text, 300)}")
        return None

    @staticmethod
    def react_target(api, target, method="PUT"):
        try:
            status, data = api.call(method, "/agents/reactions", {**target, "emoji": "eyes"})
        except ApiUnreachable as e:
            return str(e)
        return None if status == 200 else describe(status, data)

    def react(self, api, item, method="PUT"):
        return self.react_target(api, reaction_target(item), method)

    def unmark(self, api, item):
        self.acked.pop(item.get("key"), None)
        return self.react(api, item, method="DELETE")

    def reply(self, api, item, content, idempotency_key):
        """A comment from the runner itself, in the item's thread (or on the task)."""
        comment = item.get("comment")
        if item_subject(item) == "project":
            # A project store before project items refuses a reply as parent (422); the root always takes it.
            body = {"content": content, "parentId": (comment or {}).get("rootId") or (comment or {}).get("id")}
            path = f"/projects/{item['project'].get('id')}/comments"
        else:
            body = {"content": content, **({"parentId": comment.get("id")} if comment else {})}
            path = f"/tasks/{(item.get('task') or {}).get('id')}/comments"
        st, d = api.settle("POST", path, body, idempotency_key)
        return None if 200 <= st < 300 else describe(st, d)

    def acknowledge(self, api, items):
        """Eyes on every waiting item, so one queued behind a running session is seen
        within a poll. The agent's reaction is idempotent: if another machine claims
        the item, it adds the same one."""
        for item in items:
            if stopping.is_set():
                # Each reaction would add to the shutdown; the next start marks these.
                break
            key = item.get("key")
            if key in self.acked or is_agent_comment(item) or not self.supported(item):
                continue
            if self.react(api, item) is None:
                self.acked[key] = item

    def supported(self, item):
        """Whether this runner knows the item's subject. One it does not know is
        left unclaimed and unmarked, for a runner that does."""
        if item_subject(item):
            return True
        key = item.get("key")
        if key not in self.unsupported:
            self.unsupported.add(key)
            self.state.log("item", key=key, kind=item.get("kind"), result="unsupported",
                           subject=short(item.get("subject"), 40) or None)
        return False

    def list_inbox(self, api, timeout=20):
        """(status, body) of the inbox read, project items included. A server
        before project items refuses `subjects` (422) and lists task items without it."""
        if self.ask_subjects:
            status, data = api.call("GET", f"/agents/inbox?limit={FETCH_LIMIT}&subjects={SUBJECTS}",
                                    timeout=timeout)
            if not (status == 422 and isinstance(data, dict) and data.get("code") == "agent_field_forbidden"
                    and data.get("field") == "subjects"):
                return status, data
            self.ask_subjects = False
        return api.call("GET", f"/agents/inbox?limit={FETCH_LIMIT}", timeout=timeout)

    def acknowledge_new(self, api):
        try:
            status, data = self.list_inbox(api, timeout=10)
        except ApiUnreachable:
            return
        items = (data or {}).get("data") if isinstance(data, dict) else None
        if status == 200 and isinstance(items, list):
            self.acknowledge(api, items)

    def claim(self, api, item, base):
        """The claim names this runner's presence, so the item shows who works on
        it from the start rather than from the runner's next presence write."""
        body = {"key": item.get("key")}
        # Taken before the request, so the lease it starts never looks longer than the server's.
        at = utcnow()
        if self.claim_presence and self.presence.id:
            body["presenceId"] = self.presence.id
        status, data = api.call("POST", "/agents/inbox/claim", body)
        if (status == 422 and isinstance(data, dict) and data.get("code") == "agent_field_forbidden"
                and data.get("field") == "presenceId"):
            # A server without it refuses the claim before taking it; ask once per process.
            self.claim_presence = False
            status, data = api.call("POST", "/agents/inbox/claim", {"key": item.get("key")})
        if status in (404, 409):
            self.state.log("item", **base, result="taken" if status == 409 else "gone", detail=describe(status, data))
            return None
        if status != 200:
            raise ApiUnreachable(f"claim {item.get('key')}: {describe(status, data)}")
        claimed = (data or {}).get("data") or {}
        prior = claimed["attempts"] if isinstance(claimed.get("attempts"), int) else int(item.get("attempts") or 0)
        return {"claimId": claimed.get("claimId"), "attempt": prior + 1, "at": at}

    @staticmethod
    def receipt(item, claim, **body):
        return {"key": item.get("key"), **({"claimId": claim["claimId"]} if claim.get("claimId") else {}), **body}

    def settle(self, api, action, item, claim, **fields):
        """complete, fail or release this claim, with a note for the agent's page,
        and the run's usage and research end where this server takes them."""
        if not self.settle_extras:
            fields = {k: v for k, v in fields.items() if k not in SETTLE_EXTRAS}
        body = self.receipt(item, claim, **{k: v for k, v in fields.items() if v is not None})
        idem = f"unio-inbox:{action}:{item.get('key')}:{claim['claimId']}"
        st, d = api.settle("POST", f"/agents/inbox/{action}", body, idem)
        for _ in range(2):
            refused = d.get("field") if st == 422 and isinstance(d, dict) and \
                d.get("code") == "agent_field_forbidden" else None
            if refused == "note" and "note" in body:
                # A server without the agent status refuses the note, and the
                # receipt must still land. Its own key: the refusal may be stored under the first.
                body.pop("note")
                idem += ":plain"
            elif st == 422 and SETTLE_EXTRAS & set(body):
                # Never blocks settlement: one retry without them, and none
                # asked again of a server that does not know them.
                if refused in SETTLE_EXTRAS:
                    self.settle_extras = False
                for key in SETTLE_EXTRAS:
                    body.pop(key, None)
                idem += ":bare"
            else:
                break
            st, d = api.settle("POST", f"/agents/inbox/{action}", body, idem)
        return st, d

    def agent_teams(self, api):
        """"Name (KEY)" for each team the agent is in, refreshed every TEAMS_REFRESH;
        the last list (or None) when the API cannot say. The same answer
        gives the writing language and the rows for the workspace section."""
        now = utcnow()
        if self._teams_at and now - self._teams_at < TEAMS_REFRESH:
            return self._teams
        try:
            status, data = api.call("GET", "/agents/me", timeout=10)
        except ApiUnreachable:
            return self._teams
        me = (data or {}).get("data") if status == 200 and isinstance(data, dict) else None
        teams = me.get("teams") if isinstance(me, dict) else None
        if isinstance(me, dict) and isinstance(me.get("workspace"), dict):
            self._workspace = me["workspace"]
        if isinstance(me, dict):
            self.language = writing_language(me)
        if isinstance(teams, list):
            self._team_rows = [t for t in teams if isinstance(t, dict) and t.get("identifier")]
            self._teams = [f"{t.get('name')} ({t.get('identifier')})" for t in self._team_rows]
            self._teams_at = now
        return self._teams

    def handle(self, api, item, h):
        """Claim, react, answer, settle one item. Returns 'stop' when the poll must end."""
        key = item.get("key")
        subject = item_subject(item)
        record = item.get(subject) or {}
        if subject == "project":
            base = {"key": key, "kind": item.get("kind"), "project": record.get("slug") or record.get("id")}
        else:
            base = {"key": key, "kind": item.get("kind"), "task": record.get("key")}

        if is_agent_comment(item):
            # Answering another agent could start two agents replying to each other.
            claim = self.claim(api, item, base)
            if claim:
                st, d = self.settle(api, "complete", item, claim, outcome="skipped", note="written by an agent")
                self.state.log("item", **base, result="completed" if st == 200 else "complete_failed",
                               outcome="skipped", note="written by an agent",
                               error=None if st == 200 else describe(st, d))
            return "continue"

        # Cloned or refreshed before the claim: a first clone can take minutes.
        snapshots = self.snapshots.for_team((record.get("team") or {}).get("identifier"), h)
        if stopping.is_set():
            return "stop"
        claim = self.claim(api, item, base)
        if not claim:
            return "continue"
        attempt = claim["attempt"]
        reaction_error = None
        if key not in self.acked:
            reaction_error = self.react(api, item)
            if reaction_error is None:
                self.acked[key] = item
        run_dir = self.state.runs_dir / safe_name(key)
        rerun = run_dir.is_dir() and any(run_dir.glob("attempt-*"))
        out = run_dir / f"attempt-{attempt}-{str(claim.get('claimId') or 'unnamed')[:8]}"
        started, started_at = time.monotonic(), utcnow()
        # Kept on disk while the session runs: a process killed outright leaves it
        # for the next one, which takes the eyes back once the claim is abandoned.
        h["current"] = {"key": key, "since": iso(started_at), "claimId": claim.get("claimId"),
                        "target": reaction_target(item)}
        self.save(h)
        # A project run names no task; the agent's page finds the project through the item.
        working = {"itemKey": key, **({"taskId": record.get("id")} if subject == "task" else {})}
        self.presence.set("working", **working)
        progress = Progress(api, self.receipt(item, claim),
                            lambda step: self.presence.set("working", step=self.presence_step(step), **working),
                            self.progress_support)
        next_ack = [time.monotonic() + self.cfg.interval]

        def on_wait(s):
            if s.step:
                progress.report(s.step, **(s.web.progress() if progress.mode else {}))
            else:
                # The heartbeat runs from the first post on, and brings a stop request with it.
                progress.tick()
            if progress.stop and progress.mode and s.stopped_by is None:
                s.stopped_by = progress.stopped_by or ""
            if time.monotonic() > next_ack[0]:
                self.acknowledge_new(api)
                next_ack[0] = time.monotonic() + self.cfg.interval

        # What a research run was: why it ran, when, where, and a gate that held it.
        research, triage = None, None
        try:
            # Asked again after the claim: the snapshot refresh before it can take minutes.
            low = desk_memory(self.cfg.memory_floor)
            if low:
                now = utcnow()
                s, v = Session(), Verdict("release", reason="memory_pressure", error=low, detail=low,
                                          retry=now + MEMORY_PAUSE, pause=now + MEMORY_PAUSE)
            else:
                teams = self.agent_teams(api)
                ask = self.research_ask(item, h)
                if ask is None:
                    thread = self.research_thread(item, h) if self.research_ready(item) else None
                    s = self.run_session(item, build_prompt(item, snapshots, attempt, rerun, teams,
                                                            self.reply_web(item), self.language, thread=thread),
                                         snapshots, out, claim, on_wait)
                    v = self.classify(s)
                    if v.kind == "research" and self.research_ready(item):
                        # Charged now: the research run below is charged on its own.
                        usd = self.charge(h, s, started_at)
                        triage = {"costUsd": usd, "turns": (s.result or {}).get("num_turns"), "run": out.name,
                                  "usage": run_usage(s.result, usd), "web": s.web.counts()}
                        ask = {"why": "thread" if thread else "escalated", "question": v.question,
                               **({"answer": thread} if thread else {})}
                    elif v.kind == "research":
                        v = Verdict("fail", cause="research_unavailable",
                                    error="the session asked for research, which this item cannot get")
                if ask is not None:
                    s, v, research = self.research(item, h, claim, ask, run_dir, on_wait, teams, rerun, progress)
        except Exception as e:  # a runner bug must still spend the attempt, or the item loops forever
            s, v = Session(), Verdict("fail", cause="runner_error",
                                      error=f"runner error: {type(e).__name__}: {short(e, 200)}")
        finally:
            h.pop("current", None)
        ev = s.result or {}
        if research:
            usd = self.charge(h, s, research["at"], "research", self.cfg.research_max_budget_usd)
            out = research.get("out") or out
            if s.answer_id:
                self.remember_thread(h, item, s.answer_id)
            if s.violation:
                research["log"]["violation"] = s.violation
                self.state.log("guard_violation", **base, kind=s.violation)
        else:
            usd = self.charge(h, s, started_at)
        stats = {"attempt": attempt, "claimId": claim.get("claimId"), "run": f"{run_dir.name}/{out.name}",
                 "durationMs": int((time.monotonic() - started) * 1000),
                 "costUsd": ev.get("total_cost_usd"), "costAssumedUsd": usd if s.started and not s.result else None,
                 "turns": ev.get("num_turns"),
                 "claudeCodeVersion": s.version, "reactionError": reaction_error,
                 "steps": progress.count or None, "progressError": progress.error,
                 "repos": [f"{x['repo']}@{x['commit']}" for x in snapshots] or None,
                 "projects": len(s.projects) or None,
                 "usage": run_usage(ev, usd if s.started else None),
                 "web": s.web.counts(s.answer_body) if s.started else None,
                 "mode": "research" if research else None, "research": research and research["log"],
                 "triage": triage}
        # What the receipt records of the run: every session of this claim.
        wire = {"usage": usage_body(merge_usage((triage or {}).get("usage"), stats["usage"]),
                                    merge_web((triage or {}).get("web"), stats["web"]), files=0)}
        if len(s.projects) > 1:
            self.state.log("warn", **base, run=stats["run"], detail="create_project called more than once",
                           projects=s.projects)

        if v.kind == "release":
            st, d = self.settle(api, "release", item, claim, reason=wire_reason(v.reason), retryAfter=iso(v.retry),
                                note=problem_message(v.reason, detail=v.detail), **wire)
            self.state.log("item", **base, **stats, result="released", reason=v.reason, error=v.error,
                           retryAfter=iso(v.retry), releaseError=None if st == 200 else describe(st, d))
            if v.reason in RESEARCH_GATE_REASONS:
                # This item's wait, not the machine's: the next item may still run.
                return "continue"
            if v.reason != "interrupted":
                self.state.record_error(h, f"{key}: {v.error}")
            if v.pause:
                self.pause(h, v.reason, v.error, v.pause, api, v.detail)
            return "stop"

        if research and v.kind in ("too_large", "ok"):
            def stopped():
                if progress.check_stop() and s.stopped_by is None:
                    s.stopped_by = progress.stopped_by or ""
                return s.stopped_by is not None

            # A stop that came after the session's last post still ends the run as stopped.
            stopped()
            limit = v.kind == "too_large" or s.stopped_by is not None
            clean = v.kind == "ok" and not v.error and v.claimed is None
            no_web = research["log"].get("noWeb")
            end, note_error = self.end_research(api, item, claim, s, limit, clean, no_web)
            attached, problems = self.attach_files(api, item, claim, s, research.get("files"), stopped=stopped)
            if s.stopped_by is not None and end != "stopped":
                # Stopped between uploads: the answer still gets the stopped line.
                limit = True
                end, error = self.end_research(api, item, claim, s, limit, clean, no_web)
                note_error = note_error or error
            research["log"]["end"] = end
            wire["research"] = {"end": end}
            research["log"].update(files=attached or None, fileErrors=len(problems) or None)
            wire["usage"] = {**(wire["usage"] or {}), "files": attached}
            if not limit:
                outcome = v.outcome
            elif s.answer_id or note_error:
                outcome = written_outcome(s.succeeded)
            else:
                outcome = "replied"
            note = RESEARCH_STOPPED_NOTE if end == "stopped" else RESEARCH_PARTIAL_NOTE if limit else v.note
            self.complete(api, item, claim, h, base, stats, outcome, note, wire, claimedOutcome=None if limit else v.claimed,
                          error=v.error, reason=None if limit else v.reason, noteError=note_error)
            if v.pause:
                self.pause(h, v.reason, v.error, v.pause, api, v.detail)
                return "stop"
            return "continue"

        if v.kind == "too_large":
            outcome = written_outcome(s.succeeded)
            note_error = None
            if not s.succeeded & COMMENT_WRITES:
                note = project_note(s, self.language) or TOO_LARGE_REPLY[self.language]
                note_error = self.reply(api, item, note, f"unio-inbox:note:{key}:{claim['claimId']}")
            self.complete(api, item, claim, h, base, stats, outcome, TOO_LARGE_NOTE, wire,
                          error=v.error, noteError=note_error)
            return "continue"

        if v.kind == "ok":
            note_error = None
            # However the run ended, whoever asked hears that the project exists.
            if not s.succeeded & COMMENT_WRITES and project_note(s):
                note_error = self.reply(api, item, project_note(s, self.language),
                                        f"unio-inbox:note:{key}:{claim['claimId']}")
            self.complete(api, item, claim, h, base, stats, v.outcome, v.note, wire, claimedOutcome=v.claimed,
                          error=v.error, reason=v.reason, noteError=note_error)
            if v.pause:
                self.pause(h, v.reason, v.error, v.pause, api, v.detail)
                return "stop"
            return "continue"

        self.state.record_error(h, f"{key}: {v.error}")
        public, message = FAIL_CAUSES[v.cause]
        st, d = self.settle(api, "fail", item, claim, error=message, reason="other", note=FAIL_NOTES[public], **wire)
        h.setdefault("failed", []).append(iso(utcnow()))
        attempts = ((d or {}).get("data") or {}).get("attempts") if st == 200 else None
        final = isinstance(attempts, int) and attempts >= FINAL_ATTEMPT
        reply_error = None
        if final:
            self.unmark(api, item)
            final_reply = FINAL_REPLY[self.language].format(reason=FAILURE_REASONS[self.language][public])
            reply_error = self.reply(api, item, final_reply, f"unio-inbox:final:{key}")
        self.state.log("item", **base, **stats, result="failed", cause=v.cause, error=v.error, final=final or None,
                       failError=None if st == 200 else describe(st, d), replyError=reply_error)
        return "continue"

    def charge(self, h, s, at, kind=None, cap=None):
        """A session's cost toward the rolling budget, and its quota reading. Returns the USD charged."""
        usd = self.session_cost(s, cap)
        if s.started:
            h.setdefault("sessions", []).append({"at": iso(at), "usd": usd, **({"kind": kind} if kind else {})})
        note_quota(h, s)
        return usd

    def presence_step(self, step):
        """A presence write has no fallback of its own: reading_source goes there
        only once a progress post showed the server takes it."""
        return "researching" if step == "reading_source" and not self.progress_support["reading_source"] else step

    def research_status(self, h):
        """The research block of health.json, which `unio runner status` prints: its limits as this process runs them."""
        cfg = self.cfg
        h["research"] = {"web": cfg.web, "protocol": cfg.researcher.is_file(), "configError": cfg.research_error,
                         "caps": {"turns": cfg.research_max_turns, "usd": cfg.research_max_budget_usd,
                                  "runsPerDay": cfg.research_daily_runs,
                                  "reserveUsd": round(cfg.daily_budget * cfg.research_reserve, 2),
                                  "timeoutS": int(cfg.research_timeout), "quotaGate": QUOTA_GATE}}

    def research_ready(self, item):
        """Whether a research run can take this item: a comment on a task, with
        web research on and the researcher protocol in place."""
        return (self.cfg.web != "off" and item_subject(item) == "task" and bool(item.get("comment"))
                and self.cfg.research_daily_runs > 0 and self.cfg.researcher.is_file())

    def reply_web(self, item):
        """The reply run's web line (web_line): it never holds the web itself."""
        if item_subject(item) == "project":
            return "project" if self.cfg.web != "off" else "off"
        return "handover" if self.research_ready(item) else "off"

    def research_ask(self, item, h, now=None):
        """Why this item goes straight to a research run, or None for a reply run:
        an escalation a gate released, or a comment that opens by asking for it.
        Any other reply in a thread the bot answered with research goes to a reply
        run told so (research_thread): a thanks must not spend a research run."""
        if not self.research_ready(item):
            return None
        now = now or utcnow()
        answer = self.research_thread(item, h)
        thread = {"answer": answer} if answer else {}
        pending = (h.get("researchPending") or {}).get(item.get("key"))
        if isinstance(pending, dict) and (parse_iso(pending.get("at")) or now) > now - timedelta(days=1):
            return {"why": "escalated", "question": pending.get("question"), **thread}
        if asks_research(item["comment"].get("content")):
            return {"why": "thread" if answer else "intent", **thread}
        return None

    def research_thread(self, item, h):
        """The bot's research answer in this item's thread, or None."""
        comment = item.get("comment") or {}
        thread = (h.get("researchThreads") or {}).get(comment.get("rootId") or comment.get("id"))
        return thread["comment"] if isinstance(thread, dict) and isinstance(thread.get("comment"), str) else None

    def remember_thread(self, h, item, answer_id, now=None):
        now = now or utcnow()
        comment = item.get("comment") or {}
        threads = h.get("researchThreads") if isinstance(h.get("researchThreads"), dict) else {}
        threads[comment.get("rootId") or comment.get("id")] = {"comment": answer_id, "at": iso(now)}
        kept = sorted(((parse_iso(e.get("at")) if isinstance(e, dict) else None, root) for root, e in threads.items()),
                      key=lambda pair: pair[0] or now, reverse=True)
        h["researchThreads"] = {root: threads[root] for at, root in kept[:RESEARCH_THREADS_MAX]
                                if at and now - at < RESEARCH_THREADS_KEPT}

    def research_gate(self, h, claim, now):
        """(reason, detail, retry) when a research run must wait, else (None, no_web, time left
        on the claim). The seven-day window answers without the web; the rest release."""
        left = (claim.get("at") or now) + CLAIM_LEASE - now
        if left < RESEARCH_MIN_LEFT:
            return "research_lease", f"{max(0, int(left.total_seconds()))} s of the claim left", now
        five = quota_used(h, "five_hour", now)
        if five and five[0] >= QUOTA_GATE:
            reset = five[1] + QUOTA_RESET_PAD if five[1] and five[1] > now else now + USAGE_LIMIT_FALLBACK
            return "research_session_window", f"{five[0]:.0%} used", min(reset, now + MAX_RETRY_AHEAD)
        runs = recent_sessions(h, now)
        research = [at for at, _, kind in runs if kind == "research"]
        if len(research) >= self.cfg.research_daily_runs:
            first = research[len(research) - self.cfg.research_daily_runs]
            return "research_runs", f"{len(research)} research runs in 24 h, cap {self.cfg.research_daily_runs}", \
                first + timedelta(hours=24)
        reserve = self.cfg.daily_budget * self.cfg.research_reserve
        clears = spend_clears([(at, usd) for at, usd, _ in runs], reserve)
        if clears:
            return "research_reserve", f"research stops at {reserve:g} USD in 24 h", clears
        week = quota_used(h, "seven_day", now)
        return None, bool(week and week[0] >= QUOTA_GATE), left

    def research(self, item, h, claim, ask, run_dir, on_wait, teams, rerun, progress=None):
        """(session, verdict, research) for a research run under this claim, or
        for the gate that holds it back (a release, with no session)."""
        now = utcnow()
        info = {"at": now, "out": None, "log": {"why": ask["why"]}}
        pending = h.get("researchPending") if isinstance(h.get("researchPending"), dict) else {}
        pending.pop(item.get("key"), None)
        gate, *rest = self.research_gate(h, claim, now)
        if not gate and progress and not progress.begin_research():
            # The server narrows the run's unio tools to its thread by this mark; a
            # run it did not take would connect with every tool.
            gate, rest = "research_unmarked", [progress.error, now + UNIO_RETRY]
        if gate:
            detail, retry = rest
            if "question" in ask:
                # A reply run asked for it: the next claim goes straight to research, without asking again.
                pending[item.get("key")] = {"question": ask.get("question"), "at": iso(now)}
            h["researchPending"] = {k: e for k, e in pending.items() if isinstance(e, dict)
                                    and (parse_iso(e.get("at")) or now) > now - timedelta(days=1)}
            info["log"]["gate"] = gate
            return Session(), Verdict("release", reason=gate, error=detail, detail=detail, retry=retry), info
        h["researchPending"] = pending
        no_web, left = rest
        web = () if no_web else tuple(self.cfg.web_tools)
        timeout = min(self.cfg.research_timeout, (left - RESEARCH_MARGIN).total_seconds())
        claim8 = str(claim.get("claimId") or "unnamed")[:8]
        info["out"] = run_dir / f"attempt-{claim['attempt']}-{claim8}-research"
        # Fresh for each attempt, so a retry can never attach what an earlier one wrote.
        files = info["files"] = run_dir / "work" / f"files-{claim8}"
        remove_tree(files)
        files.mkdir(parents=True, exist_ok=True)
        info["log"].update(noWeb=no_web or None, timeoutS=int(timeout))
        facts = {"web": web, "no_web": no_web, "minutes": max(1, int(timeout // 60)),
                 "turns": self.cfg.research_max_turns, "answer": ask.get("answer"), "question": ask.get("question"),
                 "files": files}
        prompt = build_prompt(item, [], claim["attempt"], rerun, teams, language=self.language, research=facts)
        s = self.run_session(item, prompt, [], info["out"], claim, on_wait, research=web, timeout=timeout, files=files)
        if s.refused.get("Write"):
            # The run goes on without files; the answer offers one instead.
            self.state.log("files_unavailable", key=item.get("key"), error=s.refused["Write"])
        v = self.classify(s, timeout=timeout)
        if v.kind == "research":
            v = Verdict("fail", cause="no_outcome", error="a research run asked for research")
        return s, v, info

    def end_research(self, api, item, claim, s, limit, clean, no_web=False):
        """(how the research ended, error): its answer comment closed, or the
        runner's own reply when a run at its limit posted none. `limit`: the run
        stopped at a cap, a timeout or the web check; `clean`: it ended as its
        protocol says. A marker left in the answer gives way to the limit line,
        except after a clean end, where it just goes."""
        language = self.language
        stopped = s.stopped_by is not None
        closing = RESEARCH_STOPPED[language]["line"].format(stopped=stopped_words(language, s.stopped_by)) \
            if stopped else RESEARCH_LIMIT[language]
        if s.answer_id:
            body = s.answer_body
            if limit:
                text = swap_marker(body, closing, append=True)
            elif has_marker(body):
                text = swap_marker(body, None if clean else RESEARCH_LIMIT[language])
            else:
                return ("no_web" if no_web else "complete"), None
            partial = limit or not clean
            end = "stopped" if stopped else "partial" if partial else "no_web" if no_web else "complete"
            if body is None:
                return end, "the answer's text is unknown: its marker stays"
            error = self.edit_comment(api, s.answer_id, text)
            if error is None:
                s.answer_body = text
            return end, error
        if not limit:
            return ("no_web" if no_web else "complete"), None
        lead = f"**{stopped_words(language, s.stopped_by)}**" if stopped else None
        reply = unfinished_reply(language, research_sources(s.web.sources, self.unio_hosts()), lead)
        return ("stopped" if stopped else "partial"), self.post_research_reply(api, item, claim, reply)

    def attach_files(self, api, item, claim, s, folder, now=None, stopped=None):
        """Checks the run's files and uploads what passes to its answer, or to the
        task when the comment asks for that in words and its author may change the
        task (when the item does not say, the server decides). `stopped`, asked
        between uploads, says whether a person stopped the run, which skips the
        rest. Returns (attached, problems) and logs every file left out."""
        now = now or utcnow()
        if not folder or not s.answer_id or s.answer_body is None:
            return 0, []
        kept, dropped = check_files(folder, s.answer_body)
        for name, reason in dropped:
            self.state.log("file_dropped", key=item.get("key"), file=name, reason=reason)
        comment = item.get("comment") or {}
        author = comment.get("author") or {}
        target = "task" if wants_task_file(comment.get("content")) and author.get("canUpdateTasks") is not False \
            else "comment"
        attached, problems = 0, []
        for n, f in enumerate(kept):
            if s.stopped_by is not None or (n and stopped and stopped()):
                self.state.log("file_dropped", key=item.get("key"), file=f["name"], reason="stopped on request")
                continue
            if (claim.get("at") or now) + CLAIM_LEASE - utcnow() < FILES_LEASE_LEFT:
                problems.append((f, "too little of the claim was left"))
                continue
            error = self.upload_file(api, item, claim, s, f, target)
            if error and target == "task":
                # The task refused it (rights, its last free slots): the answer keeps it.
                self.state.log("file_target", key=item.get("key"), file=f["name"], error=error)
                error = self.upload_file(api, item, claim, s, f, "comment")
            if error:
                problems.append((f, error))
                self.state.log("file_failed", key=item.get("key"), file=f["name"], error=error)
            else:
                attached += 1
        if problems:
            lines = "\n".join(FILE_FAILED[self.language].format(name=f["shown"]) for f, _ in problems)
            text = f"{s.answer_body.rstrip()}\n\n{lines}"
            if self.edit_comment(api, s.answer_id, text) is None:
                s.answer_body = text
        return attached, problems

    def upload_file(self, api, item, claim, s, f, target):
        """POST /agents/inbox/files: JSON text, never multipart, under the token
        alone, as progress is; the key and claim in the body name the run."""
        body = self.receipt(item, claim, commentId=s.answer_id, name=f["name"], content=f["content"],
                            note=file_note(s.answer_body, f["shown"]) or f["shown"])
        if target != "comment":
            body["target"] = target
        if f["render"]:
            body["render"] = "pdf"
        idem = file_idempotency_key(item.get("key"), claim.get("claimId"), f["name"], target)
        try:
            # Raw UTF-8: \u escapes would make accented text up to six times larger
            # against the API's body limit.
            st, d = api.settle("POST", "/agents/inbox/files", body, idem, timeout=60, ascii_only=False)
        except ApiUnreachable as e:
            return str(e)
        return None if 200 <= st < 300 else describe(st, d)

    def edit_comment(self, api, comment_id, content):
        """The runner's edit of the run's answer, under the token alone: the server
        admits an agent's edit of its own comment (agentGuard.commentOwner), and
        no scope header ties it to a claim that may be ending."""
        try:
            st, d = api.settle("PUT", f"/comments/{comment_id}", {"content": content}, None)
        except ApiUnreachable as e:
            return str(e)
        return None if 200 <= st < 300 else describe(st, d)

    def post_research_reply(self, api, item, claim, content):
        """The runner's reply under the item's claim, through MCP so the server's
        content guard and the claim's one-comment cap apply; REST only when MCP
        could not be reached twice. create_comment answers a retry within 10
        minutes with the comment it already posted."""
        comment = item.get("comment") or {}
        mcp = Mcp(self.cfg.mcp_url, api.token, scope_headers(item, claim))
        arguments = {"task": (item.get("task") or {}).get("key") or (item.get("task") or {}).get("id"),
                     "body": content, **({"reply_to": comment["id"]} if comment.get("id") else {})}
        error = None
        for _ in range(2):
            answer, error = mcp.call_tool("create_comment", arguments)
            if answer is not None:
                return None
            if not error.transport:
                # A 409 agent_research_comment_cap means the run's own answer is out
                # though the stream never showed it: REST, under no scope, would post a second.
                self.state.log("research_reply_refused", key=item.get("key"), error=error)
                return error
        fallback = self.reply(api, item, content, f"unio-inbox:note:{item.get('key')}:{claim['claimId']}")
        return f"{error}; {fallback}" if fallback else None

    def complete(self, api, item, claim, h, base, stats, outcome, note, wire=None, **extra):
        st, d = self.settle(api, "complete", item, claim, outcome=outcome, note=note, **(wire or {}))
        if st == 200:
            h.setdefault("handled", []).append(iso(utcnow()))
            # The answer, the 👍 or the change is the signal now.
            self.unmark(api, item)
            self.state.log("item", **base, **stats, result="completed", outcome=outcome, note=note, **extra)
        else:
            self.state.record_error(h, f"complete {item.get('key')}: {describe(st, d)}")
            self.state.log("item", **base, **stats, result="complete_failed", outcome=outcome, note=note,
                           completeError=describe(st, d), **extra)

    def pause(self, h, reason, error, until, api=None, detail=None):
        h["backoffUntil"] = iso(until)
        h["backoffReason"] = reason
        h["backoffDetail"] = detail
        if reason == "usage_limit":
            # Outlives backoffUntil: reviews stay off for review_quiet_after_limit after it.
            h["usageLimitAt"] = iso(utcnow())
            # The limit is this account's: a sign-in to another one may answer now.
            h["backoffAccount"] = self.account
        self.state.record_error(h, f"{reason}: {error}")
        self.state.log("paused", reason=reason, until=iso(until), error=short(error, 300))
        self.presence.set("problem", reason=wire_reason(reason), message=problem_message(reason, until, detail))
        if api and until - utcnow() > SHORT_PAUSE:
            # Nothing is answered until the pause ends, so no waiting item may look
            # handled. Only the eyes this process put: a listed item may have none.
            for item in list(self.acked.values()):
                self.unmark(api, item)
            self.acked.clear()

    def report_state(self, h, now):
        until = parse_iso(h.get("backoffUntil"))
        reason = h.get("backoffReason")
        if until and until > now and reason:
            self.presence.set("problem", reason=wire_reason(reason),
                              message=problem_message(reason, until, h.get("backoffDetail")))
        else:
            self.presence.set("idle")

    def tidy_orphans(self, api, h, items, now):
        """Eyes a killed run left behind (SIGKILL, a power cut). Once the server has
        had time to call its claim abandoned, an item no longer listed was answered
        elsewhere or failed at the cap, and nobody will answer it here."""
        listed = {it.get("key") for it in items}
        kept = []
        for o in h.get("orphans") or []:
            since = parse_iso(o.get("since")) if isinstance(o, dict) else None
            if not since or not isinstance(o.get("target"), dict) or o.get("key") in listed \
                    or now - since > timedelta(days=1):
                continue
            if now - since < ABANDONED_AFTER:
                kept.append(o)
                continue
            error = self.react_target(api, o["target"], "DELETE")
            self.state.log("orphan", key=o.get("key"), result="unmarked" if error is None else "unmark_failed",
                           error=error)
            if error:
                kept.append(o)
        if kept:
            h["orphans"] = kept
        else:
            h.pop("orphans", None)

    def poll(self, dry_run=False):
        """One poll: how many items it listed, or None when the inbox could not be read."""
        h = {} if dry_run else self.state.health()
        now = utcnow()
        if not dry_run:
            self.state.ensure()
            h["lastPollAt"] = iso(now)
            self.review_status(h)
            self.needs_status(h)
            self.status_status(h)
            self.research_status(h)
            left = h.pop("current", None)
            if isinstance(left, dict) and left.get("target"):
                h.setdefault("orphans", []).append(left)
        token = self.cfg.token()
        if not token:
            return self._poll_error(h, f"no token in {self.cfg.token_file} ({self.cfg.token_hint})", dry_run)
        api = Api(self.cfg.api, token)
        try:
            status, data = self.list_inbox(api)
        except ApiUnreachable as e:
            return self._poll_error(h, str(e), dry_run)
        items = (data or {}).get("data") if isinstance(data, dict) else None
        if status != 200 or not isinstance(items, list):
            return self._poll_error(h, f"inbox: {describe(status, data)}", dry_run)
        if dry_run:
            print_items(items)
            return len(items)
        h["lastOkAt"] = iso(now)
        self.tidy_orphans(api, h, items, now)
        if not stopping.is_set():
            self.recheck_limit(api, h, now)
        if items and not stopping.is_set():
            self._handle_items(api, items, h, now)
        self.report_state(h, utcnow())
        self.save(h)
        return len(items)

    def claude_account(self):
        """The account Claude Code is signed in to now (account_id), or None."""
        try:
            p = text_run([self.cfg.claude, "auth", "status", "--json"], timeout=60, env=self.session_env())
            return account_id(json.loads(p.stdout))
        except (OSError, subprocess.TimeoutExpired, ValueError):
            return None

    def probe(self):
        """("ok" | a blocking_reason | "error", detail) from one turn with no tools
        and no Unio, on the model the runner answers with: a weekly limit can be
        one model's alone. A run stopped at a cap still had its turn served, so
        the account answers."""
        work = self.state.dir / "probe"
        work.mkdir(parents=True, exist_ok=True)
        # --tools takes every word up to the next option, so the prompt follows one.
        args = [self.cfg.claude, "-p", "--restricted", "--output-format", "json", "--no-session-persistence",
                "--settings", self.settings_arg(), "--strict-mcp-config", "--tools", "",
                "--max-turns", "1", "--max-budget-usd", PROBE_BUDGET]
        if self.cfg.model:
            args += ["--model", self.cfg.model]
        args.append("Reply with the word OK.")
        try:
            p = text_run(args, timeout=PROBE_TIMEOUT, env=self.session_env(), cwd=str(work))
        except (OSError, subprocess.TimeoutExpired) as e:
            return "error", short(str(e), 300)
        finally:
            remove_project_dirs(work)
        try:
            ev = json.loads(p.stdout)
        except ValueError:
            ev = {}
        ev = ev if isinstance(ev, dict) else {}
        if ev.get("subtype") in CAP_SUBTYPES or (p.returncode == 0 and ev.get("result") is not None
                                                  and not ev.get("is_error")):
            return "ok", None
        detail = f"{ev.get('result') or ''}\n{p.stderr or ''}".strip()
        return blocking_reason(detail, ev.get("api_error_status")) or "error", short(detail, 300)

    def recheck_limit(self, api, h, now):
        """A usage-limit pause belongs to the account that hit it. While one holds,
        every ACCOUNT_CHECK this asks Claude Code which account is signed in; when
        it is another one, or the pause never recorded one (2.4.2 and older), one
        probe asks whether this account can answer. If it can, the pause ends, and
        so do the old account's quota readings and the reviews' quiet time after
        a limit. If it is limited too, the pause takes its reset and its account."""
        until = parse_iso(h.get("backoffUntil"))
        if not until or until <= now or h.get("backoffReason") != "usage_limit":
            return
        if self.account_checked_at and now - self.account_checked_at < ACCOUNT_CHECK:
            return
        if self.probe_hold and now < self.probe_hold:
            return
        self.account_checked_at = now
        # `claude auth status` and the probe are processes a short machine cannot spare.
        if desk_memory(self.cfg.memory_floor):
            return
        account = self.claude_account()
        if not account or account == h.get("backoffAccount"):
            return
        self.account = account
        verdict, detail = self.probe()
        if verdict == "ok":
            self.probe_hold = None
            h["backoffUntil"] = h["backoffReason"] = h["backoffDetail"] = None
            h["backoffAccount"] = h["usageLimitAt"] = None
            h["quota"] = {}
            self.state.log("resumed", reason="account_switched")
            self.presence.set("idle")
        elif verdict == "usage_limit":
            self.probe_hold = None
            reset = usage_reset(detail, now) or now + USAGE_LIMIT_FALLBACK
            self.pause(h, "usage_limit", detail or "usage limit", reset, api)
        else:
            self.probe_hold = now + PROBE_RETRY
            self.state.log("probe_failed", reason=verdict, error=detail)

    def budget_pause(self, api, h, now):
        over = self.over_budget(h, now)
        if over:
            self.pause(h, "budget", over[1], over[0], api, over[1])
        return bool(over)

    def memory_pause(self, api, h, now):
        low = desk_memory(self.cfg.memory_floor)
        if low:
            self.pause(h, "memory_pressure", low, now + MEMORY_PAUSE, api, low)
        return bool(low)

    def _handle_items(self, api, items, h, now):
        until = parse_iso(h.get("backoffUntil"))
        if until and until > now:
            return
        h["backoffUntil"] = h["backoffReason"] = h["backoffDetail"] = h["backoffAccount"] = None
        if self.budget_pause(api, h, now):
            return
        # Before ready(): its `claude auth status` is a process this machine cannot spare now.
        if self.memory_pause(api, h, now):
            return
        reason, error = self.ready()
        if reason:
            self.pause(h, reason, error, now + MACHINE_PAUSE, api)
            return
        self.acknowledge(api, items)
        for item in items:
            if not self.supported(item):
                continue
            if stopping.is_set() or self.budget_pause(api, h, utcnow()) or self.memory_pause(api, h, utcnow()):
                break
            try:
                step = self.handle(api, item, h)
            except ApiUnreachable as e:
                self.state.record_error(h, str(e))
                self.state.log("poll_error", error=str(e))
                break
            # The settled item is no longer what the runner works on, even while
            # the next one's snapshot refreshes.
            self.report_state(h, utcnow())
            self.save(h)
            if step == "stop":
                break

    def _poll_error(self, h, message, dry_run):
        if dry_run:
            print(f"unio-inbox: {message}", file=sys.stderr)
            return None
        self.state.record_error(h, message)
        self.state.log("poll_error", error=short(message, 500))
        self.presence.set("problem", reason="unio_unavailable", message=problem_message("inbox_unreadable"))
        self.save(h)
        return None

    def locked_poll(self, once=False):
        """The poll's listed count, None when the inbox could not be read, or BUSY
        when another poll (the service, or a manual --once) holds the lock."""
        self.state.ensure()
        with file_lock(self.state.lock_file) as held:
            if not held:
                return BUSY
            self.presence.start()
            self.state.sweep()
            listed = self.poll()
            if once:
                self.presence.close(ended=False)
                self.save(self.state.health())
            elif listed == 0:
                # Under the poll's lock, so the next sweep() cannot delete a session's MCP config.
                self.review_ran = False
                self.review_tick()
                if not self.review_ran:
                    self.needs_tick()
                # No model runs here, so a review that just ran does not hold it back.
                self.status_tick()
            return listed

    def serve(self, updater=None):
        """Poll until stopped. Returns the exit status: 0, or RESTART_EXIT once
        `updater` brought newer code into the clone."""
        self.state.ensure()
        # Before the start line, which unio-runner waits for before it may ask a stop.
        asked, watched = self.watch_stop_file() if self.cfg.workspace else (None, None)
        self.state.log("start", pid=os.getpid(), api=self.cfg.api, interval=self.cfg.interval, version=VERSION,
                       reviews=self.cfg.review_mode, web=self.cfg.web, needs=self.cfg.needs_mode,
                       researchError=self.cfg.research_error,
                       status=self.cfg.status_mode,
                       workspace=self.cfg.workspace, envFile=self.cfg.env_keys or None,
                       autoUpdate=("on" if updater else "off") if self.cfg.workspace else None)
        if not sys.platform.startswith("linux"):
            self.state.log("memory_guard_off", detail=f"no /proc/meminfo on {platform_name()}: answers never wait "
                                                      "for memory here")
        elif self.cfg.memory_floor:
            self.state.log("memory_guard", floorGiB=self.cfg.memory_floor)
        elif self.cfg.workspace:
            self.state.log("memory_guard_off", error=self.cfg.memory_error,
                           detail="no UNIO_INBOX_MEMORY_FLOOR_GIB set: answers wait for no memory floor")
        if self.cfg.zone_note:
            self.state.log("zone_fallback", detail=self.cfg.zone_note)
        self.presence.start()
        moved = None
        while not stopping.is_set():
            if updater and updater.due(utcnow()):
                moved = self.update(updater)
                if moved:
                    self.state.log("updated", **{"from": moved[0], "to": moved[1]})
                    break
            try:
                self.locked_poll()
            except Exception as e:  # the service outlives any one bad poll
                h = self.state.health()
                self.state.record_error(h, f"runner: {type(e).__name__}: {e}")
                self.state.log("poll_error", error=f"runner: {type(e).__name__}: {short(e, 400)}")
                self.save(h)
            stopping.wait(self.cfg.interval)
        # A restart for an update keeps the row online: the new process takes it over within seconds.
        self.presence.close(ended=not moved)
        with file_lock(self.state.lock_file) as held:
            if held:
                self.save(self.state.health())
        if watched:
            watched.set()
        self.state.log("stop", pid=os.getpid(), exit=RESTART_EXIT if moved else None,
                       by="stop_file" if asked and asked.is_set() else None)
        return RESTART_EXIT if moved else 0

    def watch_stop_file(self):
        """Sets `stopping` once STOP_FILE appears. Returns two events: `asked`,
        which the watch sets when the file stopped the runner, and `done`, which
        ends the watch. A file there before this process started asked a stop
        already done."""
        path = self.state.dir / STOP_FILE
        asked, done = threading.Event(), threading.Event()

        def remove():
            try:
                path.unlink()
            except FileNotFoundError:
                pass
            except OSError:
                return False
            return True

        def watch():
            while not done.wait(1) and not stopping.is_set():
                if path.exists() and remove():
                    asked.set()
                    stopping.set()

        remove()
        threading.Thread(target=watch, daemon=True).start()
        return asked, done

    def update(self, updater):
        """An update check under the poll lock, so no --once run of this
        profile is in a session meanwhile; skipped while one is."""
        with file_lock(self.state.lock_file) as held:
            return updater.check(utcnow()) if held else None

    def review_tick(self):
        """After a poll that listed nothing: inside the look window, a candidates
        call at most every review_pass_every, and at most one review, so the
        inbox is polled again between reviews."""
        if self.cfg.review_mode == "off" or stopping.is_set():
            return
        try:
            self._review_tick(utcnow())
        except Exception as e:  # a review bug must never stop the answers
            self.review_queue = []
            self.state.log("review_error", error=f"runner: {type(e).__name__}: {short(e, 400)}")

    def review_status(self, h):
        """The reviews block of health.json, for unio-doctor: the service's
        environment is not the doctor's."""
        cfg = self.cfg
        block = h["reviews"] = h["reviews"] if isinstance(h.get("reviews"), dict) else {}
        block.update(mode=cfg.review_mode, configError=cfg.review_error,
                     window=f"{cfg.review_window_text} {cfg.review_tz}",
                     caps={"runs": cfg.review_daily_runs, "usd": cfg.review_daily_usd,
                           "reserveUsd": round(cfg.daily_budget * cfg.review_reserve, 2)})
        return block

    def _review_off(self, reason, detail):
        if reason not in self.review_off_logged:
            self.review_off_logged.add(reason)
            self.state.log("review_off", reason=reason, detail=detail)

    def _review_tick(self, now):
        cfg = self.cfg
        if cfg.review_error:
            return self._review_off("config", cfg.review_error)
        if not cfg.reviewer.is_file():
            self.review_queue = []
            return self._review_off("reviewer_missing", f"{cfg.reviewer} does not exist")
        self.review_off_logged.discard("reviewer_missing")
        if self.review_route_missing:
            return
        if not in_window(now, cfg.review_window, cfg.review_zone):
            self.review_queue = []
            return
        h = self.state.health()
        until = parse_iso(h.get("backoffUntil"))
        if until and until > now:
            return
        due = self.review_pass_at is None or now - self.review_pass_at >= cfg.review_pass_every
        limited = parse_iso(h.get("usageLimitAt"))
        if limited and now - limited < cfg.review_quiet_after_limit:
            self.review_queue = []
            if due:
                self.review_pass_at = now
                self.state.log("review_skipped", reason="usage_limit", detail=f"a usage limit at {iso(limited)}")
            return
        if due:
            self.review_pass_at = now
            self.review_pass(h, now)
        if self.review_queue and cfg.review_mode == "on" and not stopping.is_set():
            self.review_next(h, now)

    def fetch_candidates(self, api):
        """(status, rows, enabled, error) from GET /agents/projects/review."""
        try:
            status, data = api.call("GET", "/agents/projects/review", timeout=30)
        except ApiUnreachable as e:
            return 0, [], False, str(e)
        rows = data.get("data") if isinstance(data, dict) else None
        if status != 200 or not isinstance(rows, list):
            return status, [], False, f"candidates: {describe(status, data)}"
        rows = [r for r in rows if isinstance(r, dict) and isinstance(r.get("id"), str) and r.get("fingerprint")]
        return status, rows, data.get("enabled") is True, None

    def candidate(self, api, pid):
        """The project's row as the candidates route lists it now, or None."""
        status, rows, _, error = self.fetch_candidates(api)
        if error:
            self.state.log("review_error", error=short(error, 500), status=status or None)
            return None
        return next((r for r in rows if r["id"] == pid), None)

    def review_pass(self, h, now):
        """Ask which projects changed, record them, and queue the ones worth a look."""
        cfg = self.cfg
        self.review_queue = []
        block = self.review_status(h)
        block["lastPassAt"] = iso(now)
        token = cfg.token()
        if token:
            status, rows, enabled, error = self.fetch_candidates(Api(cfg.api, token))
        else:
            status, rows, enabled, error = 0, [], False, f"no token in {cfg.token_file} ({cfg.token_hint})"
        block["route"] = status or None
        if status == 404:
            # Never through _poll_error: answers go on, and the service log says it once.
            self.review_route_missing = True
            self.state.log("review_off", reason="route_missing",
                           detail="GET /agents/projects/review answered 404: the API predates project reviews")
            self.save(h)
            return
        if error:
            block.update(lastPassError=short(error, 300), lastPassErrorAt=iso(now))
            self.state.log("review_error", error=short(error, 500), status=status or None)
            self.save(h)
            return
        self.review_route_ok = True
        block["enabled"] = enabled
        if cfg.review_mode == "on" and enabled:
            data = self.load_reviews(rows, now)
            if data is None:
                block.update(lastPassError="reviews.json could not be set aside", lastPassErrorAt=iso(now))
                self.save(h)
                return
        else:
            data, _ = self.state.reviews()
        entries = (data or {}).get("projects") or {}
        queue, decisions = plan_reviews(rows, entries, now, cfg)
        eligible = len(queue)
        if cfg.review_mode == "observe":
            self.observe(queue, decisions, now)
            queue = []
        elif not enabled:
            for item in queue:
                decisions[item["row"]["id"]] = "flag_off"
            queue = []
        else:
            runs, _, _ = review_spend(h, now)
            left = max(0, cfg.review_daily_runs - runs)
            for item in queue[left:]:
                decisions[item["row"]["id"]] = "daily_runs"
            queue = queue[:left]
        self.review_queue = queue
        skipped = {}
        for reason in decisions.values():
            if reason:
                skipped[reason] = skipped.get(reason, 0) + 1
        block.update(candidates=len(rows), backlog=sum(1 for e in entries.values() if e.get("backlog")))
        self.state.log("review_pass", mode=cfg.review_mode, enabled=enabled, candidates=len(rows),
                       eligible=eligible, queued=len(queue), skipped=skipped or None)
        self.save(h)

    def observe(self, queue, decisions, now):
        """Observe mode: log each review that would run, within the daily cap, once a day."""
        today = local_day(now, self.cfg.review_zone)
        self.review_observed = {today: self.review_observed.get(today, set())}
        seen = self.review_observed[today]
        for item in queue:
            row = item["row"]
            if row["id"] in seen:
                decisions[row["id"]] = "looked_today"
            elif len(seen) >= self.cfg.review_daily_runs:
                decisions[row["id"]] = "daily_runs"
            else:
                seen.add(row["id"])
                self.state.log("review_would_run", **review_fields(row), pressure=row.get("pressure"),
                               backlog=item["backlog"] or None)

    def load_reviews(self, rows, now):
        """reviews.json, seeded from the candidates when there is none. An
        unreadable file is set aside and reseeded, never read as empty: that
        would make every project new on the same morning."""
        data, problem = self.state.reviews()
        if problem == "unreadable":
            try:
                self.state.set_aside_reviews()
            except OSError as e:
                self.state.log("review_error", error=f"reviews.json is unreadable and could not be set aside: "
                                                     f"{short(e, 200)}")
                return None
            self.state.log("review_error", error="reviews.json was unreadable: kept as reviews.json.corrupt, reseeded")
        if problem:
            projects = seed_entries(rows, now)
            data = {"version": 1, "seededAt": iso(now), "projects": projects}
            self.state.log("review_seeded", projects=len(projects),
                           backlog=sum(1 for e in projects.values() if e["backlog"]))
        else:
            for settled in reconcile_entries(data["projects"], rows, now, self.cfg):
                self.state.log("review", **settled)
        self.state.save_reviews(data)
        return data

    def review_block(self, h, now):
        """(reason, detail) while the caps hold reviews back, else None. Never a
        pause: the inbox's state is not the reviews' to change."""
        cfg = self.cfg
        runs, usd, total = review_spend(h, now)
        reserve = cfg.daily_budget * cfg.review_reserve
        if runs >= cfg.review_daily_runs:
            return "review_runs", f"{runs} reviews in 24 h, cap {cfg.review_daily_runs}"
        if usd >= cfg.review_daily_usd:
            return "review_budget", f"{usd:.2f} USD of reviews in 24 h, cap {cfg.review_daily_usd:g}"
        if total >= reserve:
            return "reserve", f"{total:.2f} USD of all runs in 24 h; reviews stop at {reserve:g}"
        over = self.over_budget(h, now)
        return ("budget", over[1]) if over else None

    def review_next(self, h, now):
        """Start the queue's next review, if the caps and the machine allow one."""
        blocked = self.review_block(h, now)
        if not blocked:
            low = desk_memory()
            blocked = ("memory_pressure", low) if low else None
        if not blocked:
            reason, error = self.ready()
            blocked = (reason, short(error, 300)) if reason else None
        if stopping.is_set():
            self.review_queue = []
            return
        if blocked:
            self.review_queue = []
            self.state.log("review_skipped", reason=blocked[0], detail=blocked[1])
            return
        data, problem = self.state.reviews()
        token = self.cfg.token()
        if problem or not token:
            # The next pass reseeds the file, or reports the token.
            self.review_queue = []
            return
        self.handle_review(Api(self.cfg.api, token), self.review_queue.pop(0), h, data)

    def handle_review(self, api, item, h, data):
        """One review: its start on disk first, then the session, then its
        outcome. Unlike handle(), it never comments, reacts or reports progress:
        a review writes one project update or nothing."""
        cfg = self.cfg
        if stopping.is_set():
            self.review_queue = []
            return
        row, entries = item["row"], data["projects"]
        pid, slug = row["id"], row.get("slug") or row["id"]
        before = dict(entries.get(pid) or {})
        started_at = utcnow()
        # A try is a start that crashed or failed on these same facts; a deferral or a
        # judgment ends the count, so the next start is a first try again.
        again = (before.get("fingerprint") == row.get("fingerprint")
                 and before.get("outcome") in ("interrupted", "failed", None) and before.get("startedAt"))
        entry = entries[pid] = {**before, "slug": slug, "fingerprint": row.get("fingerprint"), "tier": row.get("tier"),
                                "startedAt": iso(started_at), "tries": (before.get("tries") or 0) + 1 if again else 1,
                                "outcome": None, "health": row.get("health"), "nextLookAt": None,
                                "lastSeenAt": iso(started_at), "backlog": False, "fromBacklog": item["backlog"]}
        self.state.save_reviews(data)
        out = self.state.runs_dir / f"review-{safe_name(slug)}" / f"run-{started_at:%Y%m%dT%H%M%SZ}"
        started = time.monotonic()
        # No target: a review leaves no eyes behind for the next poll to take back.
        h["current"] = {"kind": "review", "key": f"project:{slug}", "since": iso(started_at)}
        self.review_ran = True
        self.save(h)
        step = ["reviewing_project" if self.review_route_ok else None]
        self.presence.set("working", step=step[0])
        next_ack = [time.monotonic() + cfg.interval]

        def on_wait(s):
            if s.step and s.step != step[0]:
                step[0] = s.step
                self.presence.set("working", step=s.step)
            if time.monotonic() > next_ack[0]:
                self.acknowledge_new(api)
                next_ack[0] = time.monotonic() + cfg.interval

        try:
            self.agent_teams(api)
            s = self.run_session(None, build_review_prompt(row, self.language), [], out, {}, on_wait, review=pid)
            v = self._ended(s, utcnow(), cfg.review_timeout)
        except Exception as e:  # failed below, so a runner bug cannot loop on one project
            s = Session(REVIEW_TOOLS, set(REVIEW_TOOLS), REVIEW_STEPS)
            v = Verdict("fail", cause="runner_error", error=f"runner error: {type(e).__name__}: {short(e, 200)}")
        finally:
            h.pop("current", None)
        ev = s.result or {}
        usd = self.session_cost(s, cfg.review_max_budget_usd)
        if s.started:
            h.setdefault("sessions", []).append({"at": iso(started_at), "usd": usd, "kind": "review"})
        note_quota(h, s)
        now = utcnow()
        outcome, reason, error = review_outcome(s, v)
        tried = POST_UPDATE in s.tool_uses.values()
        after = self.candidate(api, pid) if tried and outcome in ("posted", "deferred", "failed") else None
        allowed = parse_iso((after or {}).get("nextAllowedAt"))
        if outcome == "failed" and reason == "refused" and allowed and allowed > now:
            # A refusal whose text names no code, from a project the server now holds back.
            outcome = "deferred"
        floor = parse_iso(row.get("nextSameHealthAt"))
        if outcome == "silent" and floor and floor > started_at:
            # The server held back an update that keeps the health, so silence may
            # be that hold, not a judgment of the facts: look again once it lets
            # go, or these facts would read as judged until they change.
            outcome, reason = "deferred", f"held: {reason}"
        if outcome in ("released", "interrupted"):
            # Not the project's doing: it is charged nothing and keeps its place.
            if before:
                entries[pid] = before
            else:
                entries.pop(pid, None)
        else:
            entry.update(outcome=outcome, at=iso(now))
            if outcome == "posted":
                entry["health"] = s.posted_health or row.get("health")
                if after and after.get("fingerprint"):
                    # The post moved `since`: what it said must not read as new facts tomorrow.
                    entry["fingerprint"] = after["fingerprint"]
                entry["nextLookAt"] = (after or {}).get("nextAllowedAt")
            elif outcome == "deferred":
                entry["nextLookAt"] = iso(next_look(after or row, s.refused.get(POST_UPDATE), now))
        self.state.save_reviews(data)
        if outcome in ("posted", "deferred"):
            # A post moves the workspace's daily cap, and a deferral may be that cap:
            # the queue was planned before either, so the next tick plans it again.
            self.review_queue = []
            self.review_pass_at = None
        block = h["reviews"] = h["reviews"] if isinstance(h.get("reviews"), dict) else {}
        block["lastRunAt"] = iso(now)
        self.state.log("review", **{**review_fields(row), "slug": slug}, outcome=outcome,
                       health=entry.get("health") if outcome == "posted" else row.get("health"),
                       reason=reason, error=error,
                       nextLookAt=entry.get("nextLookAt") if outcome == "deferred" else None,
                       costUsd=ev.get("total_cost_usd"), costAssumedUsd=usd if s.started and not s.result else None,
                       turns=ev.get("num_turns"), durationMs=int((time.monotonic() - started) * 1000),
                       run=f"{out.parent.name}/{out.name}", claudeCodeVersion=s.version,
                       backlog=item["backlog"] or None)
        if v and v.kind == "release" and v.reason in REVIEW_MACHINE_REASONS:
            # Every review would fail the same way now, posted or not: the pass ends.
            self.review_queue = []
            block.update(lastPassError=short(f"{v.reason}: {v.error}", 300), lastPassErrorAt=iso(now))
            if v.reason == "usage_limit" and v.pause:
                # The limit is the inbox's too, so it pauses answers as handle() does.
                self.pause(h, v.reason, v.error, v.pause, api, v.detail)
        self.report_state(h, utcnow())
        self.save(h)

    def review_dry_run(self):
        """--reviews --dry-run: one candidates call, no model, nothing written."""
        cfg, now = self.cfg, utcnow()
        if cfg.review_error:
            print(f"unio-inbox: {cfg.review_error}", file=sys.stderr)
            return 1
        token = cfg.token()
        if not token:
            print(f"unio-inbox: no token in {cfg.token_file} ({cfg.token_hint})", file=sys.stderr)
            return 1
        status, rows, enabled, error = self.fetch_candidates(Api(cfg.api, token))
        if status == 404:
            print("unio-inbox: GET /agents/projects/review answered 404: the API predates project reviews",
                  file=sys.stderr)
            return 1
        if error:
            print(f"unio-inbox: {error}", file=sys.stderr)
            return 1
        h = self.state.health()
        data, problem = self.state.reviews()
        entries = seed_entries(rows, now) if problem else data["projects"]
        queue, decisions = plan_reviews(rows, entries, now, cfg)
        blocked = self.review_block(h, now)
        runs, usd, total = review_spend(h, now)
        left = 0 if blocked else max(0, cfg.review_daily_runs - runs)
        for item in queue[left:]:
            decisions[item["row"]["id"]] = blocked[0] if blocked else "daily_runs"
        local = now.astimezone(cfg.review_zone)
        inside = "inside" if in_window(now, cfg.review_window, cfg.review_zone) else "outside"
        print(f"Project reviews: UNIO_REVIEW={cfg.review_mode}; look window {cfg.review_window_text} {cfg.review_tz} "
              f"(now {local:%H:%M}, {inside}); workspace flag {'on' if enabled else 'off'}")
        print(f"Last 24 h: {runs} of {cfg.review_daily_runs} reviews, {usd:.2f} of {cfg.review_daily_usd:g} USD; "
              f"all runs {total:.2f} USD, reviews stop at {cfg.daily_budget * cfg.review_reserve:g}"
              + (f"; held back: {blocked[1]}" if blocked else ""))
        if problem:
            hard = sum(1 for e in entries.values() if e["backlog"])
            print(f"reviews.json: {'none yet' if problem == 'missing' else 'unreadable'}; the first pass with reviews "
                  f"on seeds all {len(rows)}, the {hard} with a hard trigger into the backlog "
                  f"({cfg.review_backlog_per_day} a day)")
        else:
            print(f"reviews.json: {len(entries)} projects, "
                  f"{sum(1 for e in entries.values() if e.get('backlog'))} in the backlog")
        print_reviews(rows, decisions)
        return 0

    def needs_status(self, h):
        """The needs block of health.json: whoever reads it lacks the service's environment."""
        block = h["needs"] = h["needs"] if isinstance(h.get("needs"), dict) else {}
        block.update(mode=self.cfg.needs_mode, configError=self.cfg.needs_error)
        return block

    def needs_tick(self):
        """After a poll that listed nothing and ran no review: a needs pass at
        most every needs_interval, unless the machine or the budget holds it."""
        if self.cfg.needs_mode == "off" or stopping.is_set():
            return
        try:
            self._needs_tick(utcnow())
        except Exception as e:  # a needs bug must never stop the answers
            self.state.log("needs", action="error", error=f"runner: {type(e).__name__}: {short(e, 400)}")

    def _needs_tick(self, now):
        cfg = self.cfg
        if cfg.needs_error:
            if "config" not in self.needs_off_logged:
                self.needs_off_logged.add("config")
                self.state.log("needs", action="off", reason="config", detail=cfg.needs_error)
            return
        if self.needs_pass_at is None and cfg.needs_mode == "on":
            # A restart (or a crash loop) does not make a pass due early.
            self.needs_pass_at = parse_iso((self.state.needs()[0] or {}).get("lastPassAt"))
        if self.needs_pass_at and now - self.needs_pass_at < cfg.needs_interval:
            return
        h = self.state.health()
        held = self.needs_hold(h, now)
        if held:
            if held[0] != self.needs_held:
                self.state.log("needs", action="held", reason=held[0], detail=held[1])
            self.needs_held = held[0]
            return
        self.needs_held = None
        self.needs_pass_at = now
        token = cfg.token()
        if not token:
            self._needs_error(h, f"no token in {cfg.token_file} ({cfg.token_hint})", now, True, {})
            return
        self.needs_pass(Api(cfg.api, token), h, now, cfg.needs_mode)

    def needs_hold(self, h, now):
        """(reason, detail) while no pass may run: what holds reviews back (a
        pause, the rolling budget) and low memory. Stopping is the caller's."""
        until = parse_iso(h.get("backoffUntil"))
        if until and until > now:
            return "paused", f"{h.get('backoffReason') or 'a pause'} until {iso(until)}"
        over = self.over_budget(h, now)
        if over:
            return "budget", over[1]
        low = desk_memory()
        return ("memory_pressure", low) if low else None

    def needs_judge_block(self, h, runs, now):
        """(reason, detail) while no check may start this pass, else None. The
        pass still keeps labels and sections in step: that costs no model."""
        cfg = self.cfg
        if runs >= cfg.needs_daily_runs:
            return "daily_runs", f"{runs} checks in 24 h, cap {cfg.needs_daily_runs}"
        _, _, total = review_spend(h, now)
        reserve = cfg.daily_budget * cfg.review_reserve
        if total >= reserve:
            return "reserve", f"{total:.2f} USD of all runs in 24 h; checks stop at {reserve:g}"
        limited = parse_iso(h.get("usageLimitAt"))
        if limited and now - limited < cfg.review_quiet_after_limit:
            return "usage_limit", f"a usage limit at {iso(limited)}"
        if self.needs_judge_hold and self.needs_judge_hold > now:
            return "held", f"a check failed for the machine; the next waits until {iso(self.needs_judge_hold)}"
        if not cfg.needs_protocol.is_file():
            return "protocol_missing", f"{cfg.needs_protocol} does not exist"
        return None

    @staticmethod
    def needs_get(api, path, timeout=20):
        """(status, the answer without its envelope, error or None)."""
        try:
            status, data = api.call("GET", path, timeout=timeout)
        except ApiUnreachable as e:
            return 0, None, str(e)
        if status != 200:
            return status, None, f"GET {path.split('?')[0]}: {describe(status, data)}"
        return status, unwrap(data), None

    def needs_people(self, api):
        """(the first names of the people the agent can see, error or None)."""
        _, people, error = self.needs_get(api, "/users/members")
        if error or not isinstance(people, list):
            return [], error or "GET /users/members: the answer is not a list"
        names = {}
        for person in people:
            if not isinstance(person, dict) or person.get("kind") == "agent":
                continue
            words = str(person.get("name") or "").split()
            if words and len(words[0]) <= 40:
                names.setdefault(words[0].casefold(), words[0])
        return list(names.values()), None

    def needs_search(self, api, first):
        query = urllib.parse.urlencode({"q": f"Needs {first}", "limit": SEARCH_LIMIT})
        _, rows, error = self.needs_get(api, f"/agents/tasks/search?{query}")
        if error:
            return [], error
        return [r for r in rows if isinstance(r, dict) and isinstance(r.get("id"), str)] if isinstance(rows, list) \
            else [], None

    def load_needs(self):
        """needs.json, or a new one. An unreadable file is set aside first, so
        the judgments and the day's checks it held can still be read."""
        data, problem = self.state.needs()
        if problem == "unreadable":
            try:
                self.state.set_aside_needs()
            except OSError as e:
                self.state.log("needs", action="error",
                               error=f"needs.json is unreadable and could not be set aside: {short(e, 200)}")
                return None
            self.state.log("needs", action="error", error="needs.json was unreadable: kept as needs.json.corrupt")
        return data if not problem else {"version": 1, "tasks": {}, "judgeRuns": []}

    def _needs_error(self, h, error, now, logging, result):
        result["error"] = error
        if logging:
            self.needs_status(h).update(lastPassAt=iso(now), lastPassError=short(error, 300),
                                        lastPassErrorAt=iso(now))
            self.state.log("needs", action="error", error=short(error, 500))
            self.save(h)
        return result

    def needs_pass(self, api, h, now, mode):
        """One pass: find the tasks waiting on a person, keep each one's label
        and sections in step, and check at most one. 'on' writes; 'observe' logs
        what it would write and check; 'dry' writes nothing at all, not even
        here. Returns {rows, people, errors, judgeBlock, error}."""
        cfg = self.cfg
        writing, logging = mode == "on", mode != "dry"
        started = time.monotonic()
        result = {"rows": [], "people": [], "errors": [], "judgeBlock": None, "error": None}
        data = self.load_needs() if writing else (self.state.needs()[0] or {"tasks": {}, "judgeRuns": []})
        if data is None:
            return self._needs_error(h, "needs.json could not be set aside", now, logging, result)
        data["judgeRuns"] = [t for t in data.get("judgeRuns") or []
                             if isinstance(t, str) and (parse_iso(t) or now) > now - timedelta(hours=24)]
        entries = data["tasks"]
        people, error = self.needs_people(api)
        if error:
            return self._needs_error(h, error, now, logging, result)
        result["people"] = people
        found = {}
        for first in people:
            if stopping.is_set():
                break
            rows, error = self.needs_search(api, first)
            if error:
                result["errors"].append(error)
            for row in rows:
                found.setdefault(row["id"].lower(), row.get("updatedAt"))
        block = result["judgeBlock"] = self.needs_judge_block(h, len(data["judgeRuns"]), now)
        ctx = {"api": api, "mcp": Mcp(cfg.mcp_url, api.token), "labels": {}, "allowed": cfg.all_repos(),
               "block": block, "mode": mode, "now": now, "errors": result["errors"], "writes": 0,
               "runs": len(data["judgeRuns"]), "gh": {}, "ghUntil": time.monotonic() + GH_PASS_SECONDS,
               "ghDown": False, "ghSkips": 0}
        read = 0
        # The tasks GitHub was asked about least recently first, should the pass run out of time for it.
        order = sorted(dict.fromkeys([*found, *entries]),
                       key=lambda t: str((entries.get(t) or {}).get("factsAt") or ""))
        for tid in order:
            if stopping.is_set():
                break
            quiet = self.needs_quiet.get(tid)
            if tid not in entries and quiet and quiet[0] == found.get(tid) and now - quiet[1] < QUIET_RECHECK:
                continue
            read += 1
            row = self.needs_task(ctx, tid, entries, found.get(tid))
            if row:
                result["rows"].append(row)
        self.needs_quiet = {tid: seen for tid, seen in self.needs_quiet.items() if tid in found}
        due = sorted((r for r in result["rows"] if r.get("due")),
                     key=lambda r: parse_iso(r["updatedAt"]) or datetime.min.replace(tzinfo=timezone.utc),
                     reverse=True)
        # New facts first: they are what a person just did.
        due.sort(key=lambda r: r["why"] == "recheck due")
        checked = None
        if due and mode != "on":
            due[0]["judge"] = f"would: {due[0]['why']}"
        elif due and not stopping.is_set():
            checked = due[0]["key"]
            due[0]["judge"] = self.needs_judge(ctx, h, data, due[0])
        if not logging:
            return result
        if writing:
            data["lastPassAt"] = iso(now)
            self.state.save_needs(data)
        if mode == "observe":
            self.needs_observe(result["rows"])
        errors = result["errors"]
        pending = sum(1 for r in result["rows"] if r["open"] and not r.get("skip"))
        self.needs_status(h).update(
            lastPassAt=iso(now), open=pending,
            judgedToday=len(data["judgeRuns"]), lastPassErrors=len(errors),
            **({"lastPassError": short(errors[0], 300), "lastPassErrorAt": iso(now)} if errors else {}))
        self.state.log("needs", action="pass", mode=mode, people=len(people), found=len(found), read=read,
                       tasks=len(result["rows"]), open=pending,
                       writes=ctx["writes"] or None, checked=checked, held=block[0] if block else None,
                       ghSkipped=ctx["ghSkips"] or None,
                       errors=errors[:3] or None, durationMs=int((time.monotonic() - started) * 1000),
                       would=True if mode == "observe" else None)
        self.save(h)
        return result

    def needs_observe(self, rows):
        """Observe mode: each task's decision and check, logged when they change."""
        seen = {}
        for row in rows:
            sig = [row["decision"], row["judge"]]
            seen[row["id"]] = sig
            if self.needs_observed.get(row["id"]) != sig:
                self.state.log("needs", action="observed", would=True, task=row["key"], people=row["people"],
                               open=row["open"], ticked=row["ticked"], label=row["label"],
                               decision=row["decision"], check=row["judge"])
        self.needs_observed = seen

    def needs_task(self, ctx, tid, entries, seen_at):
        """Read one task, keep its label and sections in step, and say whether it
        is due a check. Returns its row, or None when it has neither a Needs
        section nor the label (it is then forgotten)."""
        cfg, mode, now = self.cfg, ctx["mode"], ctx["now"]
        if not UUID_TEXT.match(tid):
            entries.pop(tid, None)
            return None
        status, body, error = self.needs_get(ctx["api"], f"/tasks/{tid}")
        view = task_view(body) if not error else None
        if status == 404:
            entries.pop(tid, None)
            return None
        if not view or view["id"] != tid:
            error = error or f"GET /tasks/{tid}: the answer is not a task"
            ctx["errors"].append(error)
            return {"id": tid, "key": str((entries.get(tid) or {}).get("key") or tid[:8].upper()),
                    "updatedAt": "", "people": [], "open": 0, "ticked": 0, "label": False, "skip": True,
                    "decision": f"unread: {short(error, 120)}", "judge": "no"}
        sections = parse_needs(view["description"])
        labelled = bool(view["needsLabels"])
        if not sections and not labelled:
            entries.pop(tid, None)
            self.needs_quiet[tid] = (seen_at, now)
            return None
        pending = open_items(sections)
        row = {"id": tid, "key": view["key"], "updatedAt": view["updatedAt"], "people": [s["name"] for s in sections],
               "open": len(pending), "ticked": sum(len(s["items"]) for s in sections) - len(pending),
               "label": labelled, "decision": "none", "judge": "no: no open item"}
        if view["deleted"] or view["clientLinked"]:
            entries.pop(tid, None)
            row.update(decision="skip: " + ("deleted" if view["deleted"] else "a client's task"), judge="no",
                       skip=True)
            return row
        entry = entries.setdefault(tid, {})
        entry.update(key=view["key"], teamKey=view["teamKey"], lastSeenAt=iso(now), labelSeen=labelled,
                     sectionSeen=bool(sections))
        plan = plan_needs(view["description"], sections, labelled)
        row["decision"] = plan_text(plan)
        changes = plan["description"] is not None or plan["add"] or plan["remove"]
        refused = changes and entry.get("refused") == write_key(view, plan)
        if refused:
            row["decision"] += " (refused before: waits for a change)"
        check = None
        if pending and ctx["block"]:
            row["judge"] = f"no: {ctx['block'][1]}"
        elif pending and entry.get("textRefused") == text_key(view["description"]):
            row["judge"] = "no: its text breaks a writing rule for agent writes, so no tick could be saved"
        elif pending:
            check, error = self.needs_facts(ctx, view, sections, entry)
            row["judge"] = f"no: {error}" if error else row["judge"]
        if changes and not refused:
            sent = ctx["writes"]
            if mode == "on":
                updated = self.needs_write(ctx, view, plan, entry, "updated")
                if updated and check and entry.get("fingerprint") == check["fp"]:
                    # The runner's own write is no new fact.
                    entry["fingerprint"] = needs_fingerprint(updated, check["comments"], check["pulls"])
                kept_sections = len(plan["done"]) < len(sections)
                kept_label = (labelled or plan["add"]) and not plan["remove"]
                if updated and not kept_sections and not kept_label:
                    entries.pop(tid, None)
            if mode != "on" or ctx["writes"] > sent:
                # One update_task per task per pass: a check waits for the next.
                row["judge"] = "no: written this pass" if pending else row["judge"]
                return row
        if check:
            judged = parse_iso(entry.get("lastJudgedAt"))
            quiet = entry.get("quiet") if isinstance(entry.get("quiet"), int) else 0
            wait = cfg.needs_recheck * 2 ** min(max(quiet - 1, 0), RECHECK_DOUBLINGS)
            why = ("never checked" if not judged else "new facts" if entry.get("fingerprint") != check["fp"]
                   else "recheck due" if now - judged >= wait else None)
            if why == "recheck due" and view.get("statusCategory") in FINISHED:
                row["judge"], why = f"no: {view['statusCategory']}, so only new facts bring a check", None
            elif why == "recheck due" and ctx["runs"] >= cfg.needs_daily_runs * RECHECK_SHARE:
                row["judge"], why = f"no: {ctx['runs']} checks in 24 h; the rest wait for new facts", None
            elif why:
                row.update(due=True, why=why, view=view, sections=sections, check=check,
                           judge="no: one check per pass")
            else:
                row["judge"] = f"no: unchanged since its check at {judged:%Y-%m-%d %H:%M} UTC"
        return row

    def needs_facts(self, ctx, view, sections, entry):
        """({fp, facts, pulls, comments}, None) for a task with open items, or
        (None, why not). facts go to the prompt; pulls, the fingerprint's view of
        them, keep the last complete line through a GitHub hiccup, so a gh
        failure never reads as new facts."""
        _, comments, error = self.needs_get(ctx["api"], f"/tasks/{view['id']}/comments")
        if error or not isinstance(comments, list):
            ctx["errors"].append(error or f"GET /tasks/{view['id']}/comments: the answer is not a list")
            return None, "comments unreadable"
        counts = comment_facts(comments)
        lines = split_lines(view["description"])
        texts = ["".join(lines[s["start"]:s["end"]]) for s in sections] + [view["description"]]
        known = entry.get("pulls") if isinstance(entry.get("pulls"), dict) else {}
        settled = entry.get("settled") if isinstance(entry.get("settled"), dict) else {}
        facts, pulls, kept, still = [], [], {}, {}
        skips = ctx["ghSkips"]
        for name, number in pull_links(texts, ctx["allowed"]):
            if stopping.is_set():
                break
            key = f"{name}#{number}"
            asked = parse_iso(settled.get(key))
            if isinstance(known.get(key), str) and asked and ctx["now"] - asked < SETTLED_RECHECK:
                line, complete, still[key] = known[key], True, settled[key]
            else:
                line, complete, final = self.pull_fact(ctx, name, number)
                if final:
                    still[key] = iso(ctx["now"])
            facts.append(line)
            kept[key] = line if complete else known.get(key)
            pulls.append(kept[key] or line)
        entry["pulls"] = {k: v for k, v in kept.items() if v}
        entry["settled"] = still
        if ctx["ghSkips"] == skips:
            entry["factsAt"] = iso(ctx["now"])
        return {"fp": needs_fingerprint(view["updatedAt"], counts, pulls), "facts": facts, "pulls": pulls,
                "comments": counts}, None

    def pull_fact(self, ctx, name, number):
        """(render_pull's line, whether gh answered every call it took, whether
        the pull request is settled), asked once a pass however many tasks link it."""
        key = f"{name}#{number}"
        if key not in ctx["gh"]:
            pr = self.gh_json(ctx, ["pr", "view", str(number), "-R", name, "--json",
                                    "number,title,state,mergedAt,mergeCommit,baseRefName,reviewDecision"])
            base = pr.get("baseRefName") if isinstance(pr, dict) else None
            if not isinstance(pr, dict):
                ctx["gh"][key] = render_pull(name, number, None), False, False
            elif pr.get("state") != "MERGED" or not isinstance(base, str) or not BRANCH.match(base):
                ctx["gh"][key] = render_pull(name, number, pr), True, pull_settled(pr)
            else:
                runs = self.gh_json(ctx, ["run", "list", "-R", name, "--branch", base, "--limit", str(RUN_LIST_LIMIT),
                                          "--json", "databaseId,name,event,status,conclusion,headSha,createdAt"])
                ctx["gh"][key] = render_pull(name, number, pr, runs), isinstance(runs, list), pull_settled(pr, runs)
        return ctx["gh"][key]

    def gh_json(self, ctx, args):
        """gh's JSON answer, or None. The runner's own gh and environment, so its
        login (GH_CONFIG_DIR in the unit) is the one the snapshots use. None
        without a call once the pass has spent GH_PASS_SECONDS on GitHub or a
        call timed out."""
        left = ctx["ghUntil"] - time.monotonic()
        if ctx["ghDown"] or left <= 0:
            ctx["ghSkips"] += 1
            return None
        env = {**os.environ, "GH_PROMPT_DISABLED": "1", "GIT_TERMINAL_PROMPT": "0"}
        try:
            p = text_run([self.cfg.gh, *args], timeout=min(GH_TIMEOUT, left), env=env)
        except subprocess.TimeoutExpired:
            ctx["ghDown"] = True
            return None
        except (OSError, ValueError):
            return None
        if p.returncode != 0:
            return None
        try:
            return json.loads(p.stdout)
        except ValueError:
            return None

    def needs_label(self, ctx, team):
        """(the id of the team's 'Needs action' label, error): create_label answers
        with the label a task there can already use, or makes it. Asked once a
        pass per team, a refusal included."""
        if not team:
            return None, "the task has no team"
        if team not in ctx["labels"]:
            answer, error = ctx["mcp"].call_tool("create_label",
                                                 {"team": team, "name": NEEDS_LABEL, "color": NEEDS_LABEL_COLOR})
            if not error and (not isinstance(answer.get("id"), str) or not answer["id"]):
                error = "create_label answered without an id"
            ctx["labels"][team] = (None, error) if error else (answer["id"], None)
        return ctx["labels"][team]

    def needs_write(self, ctx, view, plan, entry, action, labels_alone=True, **extra):
        """One update_task bringing the task in step with `plan`, against the
        updatedAt as read. Returns the task's new updatedAt, or None. With
        labels_alone, a description the server refuses still lets the label
        move, and `plan` is left saying the sections stayed. A label that
        cannot be had holds back only itself."""
        base = {"task": view["key"], "taskId": view["id"], "decision": plan_text(plan), **extra}
        key = write_key(view, plan)
        if entry.get("refused") == key:
            # The same write on the same version of the task would be refused again.
            self.state.log("needs", action="write_skipped", **base, reason="refused before")
            return None
        args = {"task": view["id"], "expected_updated_at": view["updatedAt"]}
        if plan["description"] is not None:
            args["description"] = plan["description"]
        if plan["add"]:
            label, error = self.needs_label(ctx, view["teamKey"])
            if error:
                self.state.log("needs", action="write_failed", **base, error=short(error, 500))
                if "description" not in args:
                    return None
                # The ticks or the finished sections still go; the next pass asks for the label again.
                plan["add"] = False
                base["decision"] = plan_text(plan)
            else:
                args["add_labels"] = [label]
        if plan["remove"]:
            args["remove_labels"] = list(view["needsLabels"])
        ctx["writes"] += 1
        answer, error = ctx["mcp"].call_tool("update_task", args)
        if error and "description" in args and own_text_refused(error, view["description"]):
            entry["textRefused"] = text_key(view["description"])
        moves_label = "add_labels" in args or "remove_labels" in args
        if error and labels_alone and moves_label and "description" in args and "breaks a writing rule" in error:
            # The person's own text (a local path, a table) breaks a rule for agent
            # writes. The section stays until they edit it; the label need not.
            self.state.log("needs", action="write_failed", **base, error=short(error, 500))
            del args["description"]
            plan.update(description=None, done=[])
            base["decision"] = plan_text(plan)
            answer, error = ctx["mcp"].call_tool("update_task", args)
        if error and CONFLICT.search(error):
            self.state.log("needs", action="conflict", **base, error=short(error, 300))
            return None
        if error:
            if error.startswith("update_task refused:"):
                entry["refused"] = key
            self.state.log("needs", action="write_failed", **base, error=short(error, 500))
            return None
        entry.pop("refused", None)
        if "description" in args:
            entry.pop("textRefused", None)
        updated = answer.get("updatedAt") if isinstance(answer.get("updatedAt"), str) else None
        self.state.log("needs", action=action, **base, updatedAt=updated)
        return updated or view["updatedAt"]

    def task_url(self, api, view):
        """The task's link in the web app, built as the server builds it (task_url.ts)."""
        self.agent_teams(api)
        ws = self._workspace if isinstance(self._workspace, dict) else {}
        app, clerk = ws.get("appUrl"), ws.get("clerkId")
        if not isinstance(app, str) or not re.match(r"^https?://[^\s<>()]+$", app) or not isinstance(clerk, str) \
                or not PROMPT_FACT.match(clerk) or not PROMPT_FACT.match(view["key"]):
            return None
        return f"{app.rstrip('/')}/app/tasks/{view['key']}/{slugify_task_name(view['title'])}?ws={clerk}"

    def needs_judge(self, ctx, h, data, row):
        """One check: its start on disk first, then the session, then the items
        it names done, ticked by the runner after reading the task again.
        Returns the row's check column."""
        cfg, api, view = self.cfg, ctx["api"], row["view"]
        low = desk_memory()
        blocked = ("memory_pressure", low) if low else None
        if not blocked:
            reason, error = self.ready()
            blocked = (reason, short(error, 300)) if reason else None
        if stopping.is_set():
            return "no: the runner is stopping"
        if blocked:
            self.state.log("needs", action="check_skipped", task=view["key"], reason=blocked[0], detail=blocked[1])
            return f"no: {blocked[1]}"
        now = utcnow()
        zone = cfg.needs_zone
        items = open_items(row["sections"])
        url = self.task_url(api, view)
        prompt = build_needs_prompt(view, items, row["check"]["facts"], f"{now.astimezone(zone):%Y-%m-%d}",
                                    getattr(zone, "key", "local time"), url, self.language)
        entry = data["tasks"].setdefault(view["id"], {})
        before = {k: entry.get(k) for k in ("lastJudgedAt", "fingerprint")}
        # Charged before it runs, so a task that kills the runner cannot keep it in a loop.
        entry.update(lastJudgedAt=iso(now), fingerprint=row["check"]["fp"])
        data["judgeRuns"].append(iso(now))
        self.state.save_needs(data)
        out = self.state.runs_dir / f"needs-{safe_name(view['key'])}" / f"run-{now:%Y%m%dT%H%M%SZ}"
        h["current"] = {"kind": "needs", "key": f"task:{view['key']}", "since": iso(now)}
        self.save(h)
        step = ["reading_task"]
        self.presence.set("working", taskId=view["id"], step=step[0])
        next_ack = [time.monotonic() + cfg.interval]
        started = time.monotonic()

        def on_wait(s):
            if s.step and s.step != step[0]:
                step[0] = s.step
                self.presence.set("working", taskId=view["id"], step=s.step)
            if time.monotonic() > next_ack[0]:
                self.acknowledge_new(api)
                next_ack[0] = time.monotonic() + cfg.interval

        try:
            s = self.run_session(None, prompt, [], out, {}, on_wait, needs=True)
            v = self._ended(s, utcnow(), cfg.needs_timeout)
        except Exception as e:  # charged above, so a runner bug cannot loop on one task
            s = Session(NEEDS_TOOLS, None, NEEDS_STEPS, builtin=())
            v = Verdict("fail", cause="runner_error", error=f"runner error: {type(e).__name__}: {short(e, 200)}")
        finally:
            h.pop("current", None)
        ev = s.result or {}
        usd = self.session_cost(s, cfg.needs_max_budget_usd)
        if s.started:
            h.setdefault("sessions", []).append({"at": iso(now), "usd": usd, "kind": "needs"})
        elif iso(now) in data["judgeRuns"]:
            data["judgeRuns"].remove(iso(now))
        note_quota(h, s)
        others = sorted({name for name in s.tool_uses.values() if name not in NEEDS_TOOLS}) + foreign_reads(s, view)
        ticked, reason, error = None, None, None
        if v and v.kind == "release":
            # Not the task's doing: it is charged nothing and keeps its place.
            outcome, reason, error = "released" if v.reason in REVIEW_MACHINE_REASONS else "interrupted", v.reason, v.error
            entry.update(before)
            if v.reason in REVIEW_MACHINE_REASONS:
                self.needs_judge_hold = utcnow() + MACHINE_PAUSE
                if v.reason == "usage_limit" and v.pause:
                    # The limit is the inbox's too, so it pauses answers as handle() does.
                    self.pause(h, v.reason, v.error, v.pause, api, v.detail)
        elif others:
            outcome, reason, error = "discarded", "unexpected_calls", f"the session called {', '.join(others)}"
            self.state.log("warn", task=view["key"], run=f"{out.parent.name}/{out.name}",
                           detail=f"a needs check called {', '.join(others)}; its verdict is discarded")
        elif v:
            outcome, reason, error = "failed", v.cause if v.kind == "fail" else "too_large", v.error
        else:
            ticks, error = parse_needs_verdict(session_text(s), items)
            if error:
                outcome, reason = "invalid", "verdict"
            elif not ticks:
                outcome = "nothing_done"
            else:
                outcome, reason, error, ticked = self.needs_tick_write(ctx, data, view, row, ticks)
        if outcome == "nothing_done":
            quiet = entry.get("quiet") if isinstance(entry.get("quiet"), int) else 0
            entry["quiet"] = min(quiet + 1, RECHECK_DOUBLINGS + 1) if row["why"] == "recheck due" else 1
        elif outcome == "ticked":
            entry.pop("quiet", None)
        note = (final_json(session_text(s)) or {}).get("note") if outcome in ("nothing_done", "ticked") else None
        self.state.log("needs", action="checked", task=view["key"], taskId=view["id"], why=row["why"],
                       outcome=outcome, reason=reason, error=short(error, 300) if error else None, ticked=ticked,
                       note=short(note, 200) if isinstance(note, str) else None,
                       costUsd=ev.get("total_cost_usd"), costAssumedUsd=usd if s.started and not s.result else None,
                       turns=ev.get("num_turns"), durationMs=int((time.monotonic() - started) * 1000),
                       run=f"{out.parent.name}/{out.name}", claudeCodeVersion=s.version)
        self.state.save_needs(data)
        self.report_state(h, utcnow())
        self.save(h)
        return f"yes: {row['why']}; {outcome}"

    def needs_tick_write(self, ctx, data, view, row, ticks):
        """Tick what a check found done, on the task as it is now: if anyone
        changed it since the check began, this round is skipped. Returns
        (outcome, reason, error, ticked)."""
        index = {i["line"]: i["index"] for i in open_items(row["sections"])}
        ticked = [{"item": index[n], "outcome": outcome} for n, outcome in sorted(ticks.items())]
        _, body, error = self.needs_get(ctx["api"], f"/tasks/{view['id']}")
        again = task_view(body) if not error else None
        if not again or again["id"] != view["id"]:
            return "failed", "reread", error or "the task could not be read again", ticked
        if again["updatedAt"] != view["updatedAt"]:
            return "changed", None, f"the task changed at {again['updatedAt']} during the check", ticked
        try:
            text = tick_items(again["description"], ticks, f"{utcnow().astimezone(self.cfg.needs_zone):%Y-%m-%d}")
        except ValueError as e:
            return "failed", "tick", str(e), ticked
        sections = parse_needs(text)
        plan = plan_needs(text, sections, bool(again["needsLabels"]))
        if plan["description"] is None:
            plan["description"] = text
        entry = data["tasks"].setdefault(view["id"], {})
        # Never the label alone: it would come back next pass while the items stay open.
        updated = self.needs_write(ctx, again, plan, entry, "ticked", labels_alone=False, ticked=ticked)
        if not updated:
            return "write_failed", None, "update_task did not go through (see the needs log line)", ticked
        check = row["check"]
        entry["fingerprint"] = needs_fingerprint(updated, check["comments"], check["pulls"])
        if not plan["open"] and len(plan["done"]) == len(sections):
            data["tasks"].pop(view["id"], None)
        return "ticked", None, None, ticked

    def needs_dry_run(self):
        """--needs --dry-run: one pass in observe mode, printed; nothing written anywhere, no model."""
        cfg, now = self.cfg, utcnow()
        if cfg.needs_error:
            print(f"unio-inbox: {cfg.needs_error}", file=sys.stderr)
            return 1
        token = cfg.token()
        if not token:
            print(f"unio-inbox: no token in {cfg.token_file} ({cfg.token_hint})", file=sys.stderr)
            return 1
        h = self.state.health()
        result = self.needs_pass(Api(cfg.api, token), h, now, "dry")
        if result["error"]:
            print(f"unio-inbox: {printable(result['error'])}", file=sys.stderr)
            return 1
        data, problem = self.state.needs()
        runs = sum(1 for t in (data or {}).get("judgeRuns") or []
                   if isinstance(t, str) and (parse_iso(t) or now) > now - timedelta(hours=24))
        print(f"Needs check: UNIO_NEEDS={cfg.needs_mode}; a pass every {cfg.needs_interval.total_seconds() / 60:g} min, "
              f"a task checked again after {cfg.needs_recheck.total_seconds() / 3600:g} h unless its facts change; "
              f"{runs} of {cfg.needs_daily_runs} checks in the last 24 h")
        remembered = {"missing": "none yet", "unreadable": "unreadable (the next pass sets it aside)"}.get(
            problem) or f"{len(data['tasks'])} tasks remembered"
        print(f"needs.json: {remembered}; "
              f"people searched: {printable(', '.join(result['people']) or 'none')}")
        if result["judgeBlock"]:
            print(f"Checks held back: {result['judgeBlock'][1]}")
        for error in result["errors"]:
            print(f"Error: {printable(short(error, 200))}")
        print_needs(result["rows"])
        return 0

    def status_status(self, h):
        """The status block of health.json, for unio-doctor."""
        block = h["status"] = h["status"] if isinstance(h.get("status"), dict) else {}
        block.update(mode=self.cfg.status_mode, configError=self.cfg.status_error,
                     doneAfterHours=round(self.cfg.status_done_after.total_seconds() / 3600, 2))
        return block

    def status_tick(self):
        """After a poll that listed nothing: a status pass at most every status_interval."""
        if self.cfg.status_mode == "off" or stopping.is_set():
            return
        try:
            self._status_tick(utcnow())
        except Exception as e:  # a status bug must never stop the answers
            self.state.log("status", action="error", error=f"runner: {type(e).__name__}: {short(e, 400)}")

    def _status_tick(self, now):
        cfg = self.cfg
        if cfg.status_error:
            if "config" not in self.status_off_logged:
                self.status_off_logged.add("config")
                self.state.log("status", action="off", reason="config", detail=cfg.status_error)
            return
        if self.status_pass_at and now - self.status_pass_at < cfg.status_interval:
            return
        h = self.state.health()
        until = parse_iso(h.get("backoffUntil"))
        if until and until > now and h.get("backoffReason") == "unio_unavailable":
            return
        self.status_pass_at = now
        token = cfg.token()
        if not token:
            self.status_status(h).update(lastPassAt=iso(now),
                                         lastPassError=f"no token in {cfg.token_file} ({cfg.token_hint})",
                                         lastPassErrorAt=iso(now))
            self.save(h)
            return
        self.status_pass(Api(cfg.api, token), h, now, cfg.status_mode)

    def status_rows(self, api):
        """(rows, error): the projects whose work calls for another status, each checked for shape."""
        try:
            status, data = api.call("GET", "/agents/projects/status")
        except ApiUnreachable as e:
            return [], str(e)
        if status == 404:
            return [], "GET /agents/projects/status: HTTP 404 (this Unio does not serve it yet)"
        if status != 200:
            return [], f"GET /agents/projects/status: {describe(status, data)}"
        rows = unwrap(data)
        if not isinstance(rows, list):
            return [], "GET /agents/projects/status: the answer is not a list"
        return [r for r in (status_row(row) for row in rows) if r], None

    def status_pass(self, api, h, now, mode):
        """One pass: read the projects to move and set each due one. 'on' writes;
        'observe' logs what it would set; 'dry' writes nothing, not even here.
        Returns {rows, moved, error}."""
        writing, logging = mode == "on", mode != "dry"
        started = time.monotonic()
        result = {"rows": [], "moved": 0, "error": None}
        rows, error = self.status_rows(api)
        if error:
            result["error"] = error
            if logging:
                if error != self.status_seen.get("_error"):
                    self.state.log("status", action="error", error=short(error, 500))
                self.status_seen["_error"] = error
                self.status_status(h).update(lastPassAt=iso(now), lastPassError=short(error, 300),
                                             lastPassErrorAt=iso(now))
                self.save(h)
            return result
        self.status_seen.pop("_error", None)
        mcp = Mcp(self.cfg.mcp_url, api.token) if writing else None
        live = set()
        for row in rows:
            if stopping.is_set():
                break
            live.add(row["id"])
            move = f"{row['to']['id']}:{row['since']}"
            decision, wait = status_decision(row, now, self.cfg.status_done_after)
            refused = self.status_refused.get(row["id"])
            if decision == "move" and refused and refused[0] == move and refused[1] > now:
                decision, wait = "held", refused[1]
            row.update(decision=decision, wait=iso(wait) if wait else None)
            result["rows"].append(row)
            fields = status_fields(row)
            if decision != "move" or not writing:
                sig = (decision, move)
                if logging and self.status_seen.get(row["id"]) != sig:
                    self.status_seen[row["id"]] = sig
                    action = "would_move" if decision == "move" else "waiting" if decision == "wait" else "held"
                    self.state.log("status", action=action, **fields, until=row["wait"],
                                   would=True if mode == "observe" else None)
                continue
            answer, error = mcp.call_tool("update_project", {"project": row["id"], "status": row["to"]["id"]})
            if error:
                if error.startswith("update_project refused:"):
                    self.status_refused[row["id"]] = (move, now + STATUS_RETRY)
                row["decision"] = "failed"
                self.state.log("status", action="move_failed", **fields, error=short(error, 500))
                continue
            self.status_refused.pop(row["id"], None)
            self.status_seen.pop(row["id"], None)
            result["moved"] += 1
            self.state.log("status", action="moved", **fields)
        # What the list no longer names needs no memory: it moved, or a person moved it.
        for pid in [p for p in self.status_refused if p not in live]:
            self.status_refused.pop(pid)
        for pid in [p for p in self.status_seen if p not in live and p != "_error"]:
            self.status_seen.pop(pid)
        if not logging:
            return result
        if rows:
            self.state.log("status", action="pass", mode=mode, rows=len(rows), moved=result["moved"] or None,
                           durationMs=int((time.monotonic() - started) * 1000),
                           would=True if mode == "observe" else None)
        self.status_status(h).update(lastPassAt=iso(now), pending=len(rows) - result["moved"],
                                     lastPassError=None)
        self.save(h)
        return result

    def status_dry_run(self):
        """--status --dry-run: one pass, printed; nothing written anywhere."""
        cfg, now = self.cfg, utcnow()
        if cfg.status_error:
            print(f"unio-inbox: {cfg.status_error}", file=sys.stderr)
            return 1
        token = cfg.token()
        if not token:
            print(f"unio-inbox: no token in {cfg.token_file} ({cfg.token_hint})", file=sys.stderr)
            return 1
        result = self.status_pass(Api(cfg.api, token), {}, now, "dry")
        if result["error"]:
            print(f"unio-inbox: {printable(result['error'])}", file=sys.stderr)
            return 1
        print(f"Project status: UNIO_STATUS={cfg.status_mode}; a pass every "
              f"{cfg.status_interval.total_seconds() / 60:g} min, a finish "
              f"{cfg.status_done_after.total_seconds() / 3600:g} h after the last task closed")
        print_status(result["rows"])
        return 0


def review_outcome(s, v):
    """(outcome, reason, error) of a review session. Posted if and only if
    post_project_update succeeded; `released` when the machine, not the
    project, made the review fail."""
    text = session_text(s)
    if POST_UPDATE in s.succeeded:
        parsed = parse_review_outcome(text)
        return "posted", parsed and parsed["reason"], v.error if v else None
    if v and v.kind == "release":
        if v.reason in REVIEW_MACHINE_REASONS:
            return "released", v.reason, v.error
        return "interrupted", v.reason, v.error
    refused = s.refused.get(POST_UPDATE)
    if refused is not None:
        code = guard_refusal(refused)
        return ("deferred", code, refused) if code else ("failed", "refused", refused)
    if v:
        return "failed", v.cause, v.error
    parsed = parse_review_outcome(text)
    if not parsed:
        return "failed", "no_outcome", "the final message has no JSON outcome line: " + short(text[-200:], 200)
    if parsed["outcome"] == "posted":
        return "failed", "no_write", "the session reported an update it never posted"
    return "silent", parsed["reason"], None


def next_look(row, refused, now):
    """When a deferred project is worth a look again: when the server allows an
    update, else when its refusal says, else in a day."""
    for at in ((row or {}).get("nextAllowedAt"), (row or {}).get("nextSameHealthAt")):
        at = parse_iso(at)
        if at and at > now:
            return at
    m = ISO_TIME.search(refused or "")
    at = parse_iso(m.group(0)) if m else None
    return at if at and at > now else now + timedelta(hours=24)


def print_reviews(rows, decisions):
    if not rows:
        print("No candidates.")
        return
    print(f"{len(rows)} candidate{'s' if len(rows) != 1 else ''}, as the next pass with reviews on would take them:")
    for row in rows:
        reason = decisions.get(row["id"])
        if reason == "blocked":
            reason += f" until {row.get('nextAllowedAt')}"
        elif reason == "same_health_floor":
            reason += f" until {row.get('nextSameHealthAt')}"
        print(f"  {str(row.get('slug') or row['id'])[:14]:<14} {row.get('health') or 'no health':<10} "
              f"{row.get('tier') or '-':<5} {row.get('pressure') or '-':<9} "
              f"{'would run' if reason is None else 'no: ' + reason}")
        print(f"  {'':<14} triggers: {', '.join(trigger_codes(row)) or 'none'}")


def status_row(row):
    """A row of GET /agents/projects/status as the pass uses it, or None when it is not one."""
    if not isinstance(row, dict):
        return None
    status, advice = row.get("status"), row.get("advice")
    if not isinstance(status, dict) or not isinstance(advice, dict):
        return None
    to, task = advice.get("to"), advice.get("task")
    if not isinstance(to, dict) or not isinstance(task, dict):
        return None
    pid, slug, key = row.get("id"), row.get("slug"), task.get("key")
    if not (isinstance(pid, str) and UUID_TEXT.match(pid) and isinstance(to.get("id"), str)
            and UUID_TEXT.match(to["id"]) and to.get("category") in PROJECT_CATEGORIES
            and advice.get("because") in STATUS_REASONS and parse_iso(advice.get("since"))):
        return None
    category = status.get("category")
    return {
        "id": pid.lower(),
        "slug": slug if isinstance(slug, str) and PROMPT_FACT.match(slug) else None,
        "from": category if category in PROJECT_CATEGORIES else None,
        "setBy": status.get("setBy") if status.get("setBy") in ("person", "agent") else None,
        "to": {"id": to["id"].lower(), "category": to["category"]},
        "because": advice["because"],
        "since": advice["since"],
        "task": key if isinstance(key, str) and PROMPT_FACT.match(key) else None,
    }


def status_decision(row, now, done_after):
    """("move", None) now, or ("wait", until) for a finish inside its day."""
    if row["because"] == "work_done":
        until = parse_iso(row["since"]) + done_after
        if until > now:
            return "wait", until
    return "move", None


def status_fields(row):
    """What the log keeps of a row: no title, nothing people wrote."""
    return {"project": row["slug"] or row["id"][:8], "projectId": row["id"], "from": row["from"],
            "to": row["to"]["category"], "because": row["because"], "task": row["task"]}


def print_status(rows):
    if not rows:
        print("No project's work calls for another status.")
        return
    print(f"{len(rows)} project{'s' if len(rows) != 1 else ''} whose work calls for another status:")
    print(f"  {'PROJECT':<12} {'FROM':<12} {'TO':<12} {'BECAUSE':<13} {'TASK':<10}  DECISION")
    for row in rows:
        decision = row["decision"] + (f" until {row['wait']}" if row.get("wait") else "")
        print(f"  {printable(row['slug'] or row['id'][:8]):<12} {row['from'] or '-':<12} "
              f"{row['to']['category']:<12} {row['because']:<13} {printable(row['task'] or '-'):<10}  {decision}")


def print_needs(rows):
    if not rows:
        print("No task has a Needs section or the label.")
        return
    print(f"{len(rows)} task{'s' if len(rows) != 1 else ''} with a Needs section or the label:")
    print(f"  {'TASK':<10} {'PEOPLE':<18} {'OPEN':>4} {'TICKED':>6}  {'LABEL':<5}  DECISION")
    for row in rows:
        people = printable(short(", ".join(row["people"]) or "-", 18))
        print(f"  {printable(row['key'][:10]):<10} {people:<18} {row['open']:>4} {row['ticked']:>6}  "
              f"{'yes' if row['label'] else 'no':<5}  {printable(row['decision'])}")
        print(f"  {'':<10} check: {printable(row['judge'])}")


def check_profile(cfg):
    """--check: whether this profile can answer, as one JSON object on stdout,
    {ok, workspace: {clerkId, name}, agent: {name}, language, problems,
    codes}: each problem an English line and, at the same index in codes, a
    stable code unio-runner words for people. It claims nothing and writes
    no presence. Exit 0 when ok, else 1."""
    problems, codes = [], []

    def problem(code, text):
        codes.append(code)
        problems.append(text)

    result = {"ok": False, "workspace": None, "agent": None, "language": None, "problems": problems, "codes": codes}
    token = cfg.token()
    if not token:
        problem("no_token", f"no runner token in {cfg.token_file}")
    else:
        try:
            status, data = Api(cfg.api, token).call("GET", "/agents/me", timeout=20)
        except ApiUnreachable as e:
            status, data = 0, None
            problem("tls_untrusted" if e.untrusted else "unio_unreachable", str(e))
        me = unwrap(data) if status == 200 else None
        if status == 401:
            problem("token_refused", "Unio refused the token: it was revoked, has expired, or its issuer may no "
                                     "longer run the agent")
        elif status == 403:
            agents_off = isinstance(data, dict) and data.get("code") == "agents_disabled"
            problem("agents_off" if agents_off else "forbidden", f"Unio refused the agent: {describe(status, data)}")
        elif status and not isinstance(me, dict):
            problem("unio_error", f"GET /agents/me: {describe(status, data)}")
        elif status:
            ws = me.get("workspace") if isinstance(me.get("workspace"), dict) else {}
            agent = me.get("agent") if isinstance(me.get("agent"), dict) else {}
            purpose = (me.get("token") or {}).get("purpose") if isinstance(me.get("token"), dict) else None
            result.update(workspace={"clerkId": ws.get("clerkId"), "name": ws.get("name")},
                          agent={"name": agent.get("name")}, language=writing_language(me))
            if purpose != "runner":
                problem("not_runner_token", f"the token's purpose is {purpose or 'not given'}, not runner: issue a "
                                            "runner token for the answering service")
            if cfg.workspace and ws.get("clerkId") != cfg.workspace:
                problem("wrong_workspace", f"the token belongs to workspace {ws.get('clerkId')}, not {cfg.workspace}")
    if not (shutil.which(cfg.claude) or Path(cfg.claude).is_file()):
        problem("claude_missing", f"Claude Code was not found ({cfg.claude})")
    result["ok"] = not problems
    print(json.dumps(result))
    return 0 if result["ok"] else 1


def is_agent_comment(item):
    return ((item.get("comment") or {}).get("author") or {}).get("kind") == "agent"


def print_items(items):
    if not items:
        print("No pending items.")
        return
    print(f"{len(items)} pending item{'s' if len(items) != 1 else ''}:")
    now = utcnow()
    for it in items:
        subject = item_subject(it)
        task = it.get("task") if subject == "task" else {}
        project = it.get("project") if subject == "project" else {}
        comment = it.get("comment") or {}
        created = parse_iso(it.get("createdAt"))
        # utcnow() drops the microseconds a fresh item's time still has.
        age = f"{max(0, int((now - created).total_seconds() // 60))} min ago" if created else "?"
        who = (comment.get("author") or {}).get("name")
        text = short(comment.get("content") if comment else task.get("title"), 90)
        tries = f", {it.get('attempts')} failed attempts" if it.get("attempts") else ""
        ref = task.get("key") or project.get("slug") or project.get("id") or "?"
        skipped = "" if subject else ", unsupported: left unclaimed"
        print(printable(f"  {it.get('kind') or '?':<10} {ref:<9} {age}{tries}{skipped}  [{it.get('key')}]"))
        print(printable(f"             {who + ': ' if who else ''}{text}"))


def main(argv=None):
    ap = argparse.ArgumentParser(prog="unio-inbox", description="Answer Unio Bot's inbox.")
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--once", action="store_true", help="one poll, then exit")
    mode.add_argument("--dry-run", action="store_true", help="list pending items without claiming")
    mode.add_argument("--print-paths", action="store_true",
                      help="print the profile's config and state folders and its token file as JSON, then exit")
    mode.add_argument("--check", action="store_true",
                      help="check the token, its workspace and Claude Code, print the result as JSON, then exit")
    ap.add_argument("--reviews", action="store_true",
                    help="with --dry-run: list the project review candidates and which would run")
    ap.add_argument("--needs", action="store_true",
                    help="with --dry-run: list the tasks waiting on a person and what a needs check would do")
    ap.add_argument("--status", action="store_true",
                    help="with --dry-run: list the projects whose work calls for another status")
    ap.add_argument("--workspace", metavar="org_ID",
                    help="the workspace whose profile to use; without it, the single-machine files")
    args = ap.parse_args(argv)
    if args.workspace is not None and not WORKSPACE_ID.match(args.workspace):
        ap.error("--workspace takes a workspace id such as org_2abc")
    if args.reviews and not args.dry_run:
        ap.error("--reviews goes with --dry-run")
    if args.needs and not args.dry_run:
        ap.error("--needs goes with --dry-run")
    if args.status and not args.dry_run:
        ap.error("--status goes with --dry-run")
    if sum((args.needs, args.reviews, args.status)) > 1:
        ap.error("--needs, --reviews and --status are separate dry runs: pass one")
    if args.print_paths:
        cfg = Config(os.environ, args.workspace)
        print(json.dumps({"config": str(cfg.config_dir), "state": str(cfg.state_dir),
                          "token": str(cfg.token_file)}))
        return 0
    env_keys = apply_env_file(Path(profile_dirs(args.workspace)[0]) / "env") if args.workspace else []
    cfg = Config(os.environ, args.workspace)
    cfg.env_keys = env_keys
    if args.check:
        return check_profile(cfg)
    runner = Runner(cfg)
    if args.dry_run:
        if args.reviews:
            return runner.review_dry_run()
        if args.needs:
            return runner.needs_dry_run()
        if args.status:
            return runner.status_dry_run()
        return 0 if runner.poll(dry_run=True) is not None else 1
    # A closed terminal (SIGHUP) or SIGQUIT would otherwise end the runner with
    # its session still running in its own process group. Each system has
    # only some of them (Windows: SIGTERM, SIGINT and its own SIGBREAK).
    for name in ("SIGTERM", "SIGINT", "SIGHUP", "SIGQUIT", "SIGBREAK"):
        if hasattr(signal, name):
            signal.signal(getattr(signal, name), lambda *_: stopping.set())
    if args.once:
        listed = runner.locked_poll(once=True)
        if listed is BUSY:
            print("unio-inbox: another poll is running", file=sys.stderr)
            return 3
        return 0 if listed is not None else 1
    updater = Updater(CLONE_ROOT, cfg.git, runner.state.log) if args.workspace and autoupdate_on() else None
    return runner.serve(updater)


if __name__ == "__main__":
    # Here, not in main(): a test that calls main() keeps its own streams.
    utf8_output()
    sys.exit(main())
