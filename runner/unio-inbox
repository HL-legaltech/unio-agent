        self.stopped_by = None

    @property
    def bad_init(self):
        return bool(self.unexpected_tools or self.unio_unavailable)


class WebTrack:
    """What a session did on the web: its searches, its page reads, and each
    page's address and HTTP status as WebFetch answered (the address after
    any redirect, when the answer names one)."""

    def __init__(self):
        self.searches = 0
        self.fetches = 0
        self.asked = {}
        self.fetched = {}
        # Each landing address's asked addresses: an answer may link either.
        self.via = {}
        # The host of the page being read, as progress may name it.
        self.domain = None

    def use(self, block):
        name, args = block.get("name"), block.get("input") if isinstance(block.get("input"), dict) else {}
        if name == "WebSearch":
            self.searches += 1
        elif name == "WebFetch":
            self.fetches += 1
            if isinstance(args.get("url"), str):
                self.asked[block.get("id")] = args["url"]
            self.domain = progress_domain(args.get("url"))

    def answer(self, use_id, result):
        """A WebFetch answer: {bytes, code, codeText, result, durationMs, url} on 2.1.311,
        a plain error string when the fetch failed or was refused."""
        url = self.asked.get(use_id)
        if url is None or not isinstance(result, dict):
            return
        code = result.get("code")
        final = result.get("url") if isinstance(result.get("url"), str) else url
        if isinstance(code, int) and not isinstance(code, bool):
            self.fetched[final] = code
            self.via.setdefault(final, set()).add(url)

    @property
    def sources(self):
        """The addresses read with a 2xx answer, first read first."""
        return [url for url, code in self.fetched.items() if 200 <= code < 300]

    def cited(self, body):
        """The sources `body` links to, by the address asked or where it landed."""
        linked = {link_key(m.group(0)) for m in LINK.finditer(body or "")}
        return [url for url in self.sources if {link_key(u) for u in (url, *self.via.get(url, ()))} & linked]

    def counts(self, answer=None):
        """`sources` counts the pages read that the answer links to: a page read
        and left out of it was not a source of anything."""
        return {"searches": self.searches, "fetches": self.fetches, "sources": len(self.cited(answer))}

    def progress(self):
        """The live row: every page read so far, since no answer is final yet."""
        return {"searches": self.searches, "sources": len(self.sources), "domain": self.domain}


# An address in an answer's Markdown, up to the parenthesis that closes its link.
LINK = re.compile(r"https?://[^\s<>()\[\]\"']+")


def link_key(url):
    return url.rstrip(".,;:!?/")


def merge_web(first, second):
    if not first or not second:
        return second or first
    return {key: (first.get(key) or 0) + (second.get(key) or 0) for key in ("searches", "fetches", "sources")}


def progress_domain(url):
    """The host progress may name for a page: one the server's rule takes, never
    an IP, and without a leading "www." that only lengthens the row."""
    try:
        host = (urllib.parse.urlsplit(str(url or "")).hostname or "").rstrip(".")
    except ValueError:
        return None
    if host.startswith("www.") and "." in host[4:]:
        host = host[4:]
    if not host or len(host) > 253 or not DOMAIN.match(host) or all(p.isdigit() for p in host.split(".")):
        return None
    return host


class Verdict:
