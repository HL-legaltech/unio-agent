def read_env_file(path):
    """A profile's env file as {KEY: VALUE}: one KEY=VALUE a line, '#' lines
    are comments, and quotes around a whole value go."""
    try:
        text = Path(path).read_text(encoding="utf-8").lstrip("\ufeff")
    except OSError:
        return {}
    values = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        if ENV_KEY.match(key) and key not in PATH_KEYS:
            values[key] = value
    return values


def apply_env_file(path, environ=os.environ):
    """Sets each variable the env file holds and the environment does not: the
    real environment wins. Returns the names it set, for the start line."""
    taken = []
    for key, value in read_env_file(path).items():
        if key not in environ:
            environ[key] = value
            taken.append(key)
    return taken


