        self.required = required
        self.allowed = allowed
        self.refused_at_init = set(refused)
        self.builtin = set(builtin)
        self.steps = steps
        self.tools = None
        self.version = None
        self.unexpected_tools = []
        self.unio_unavailable = None
        self.tool_uses = {}
        self.tool_inputs = {}
        self.succeeded = set()
        # The text of each tool's last refused call: a review reads the guard's code in it.
        self.refused = {}
        self.posted_health = None
        # "[name](url)" of each project create_project answered with, for a note if the run stops.
        self.projects = []
        self.step = None
        self.result = None
        self.returncode = None
        self.started = False
        self.start_error = None
        self.timed_out = False
        self.interrupted = False
        self.stderr_tail = ""
        # The subscription's windows as the last rate_limit_event gave them (rate_limits()),
        # each with "at", when it arrived.
        self.rate_limits = {}
        self.web = WebTrack()
        # The run's answer comment, from its first create_comment the server took, and
        # the latest body sent to it: no agent route reads a comment back.
